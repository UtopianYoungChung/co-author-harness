# Older / bulk artifact drops (single-release policy: do not commit)
releases/
# Do not ignore references/ wholesale: package normative law lives there
# (schemas/, templates/, protocols). v0.14.0 — blanket references/ hid new
# tracked paths from `git add`. Ignore only known bulk subtrees if needed.
legacy/
proposals/
.claude/
.worktrees/
.superpowers/


# Optional local unpack trees (regenerate from releases/ or source root)
unpacked/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local probe / scratch
.write-probe
.harness-test-scratch/
/assignment-milestone-checkpoint-*/
/full-run-valid-template-*/
/.centroid-check-smoke-*/
/scripts/_piw_acceptance_last_run.json

# OS / editor
Thumbs.db
.DS_Store
*.swp
*~

# Plugin bundles (build artefacts; built by scripts/build-plugin.py from
# git ls-tree HEAD) are never tracked. .github/workflows/release.yml builds
# the Claude Desktop / Cowork .plugin and .zip for each version bump on main
# (or vX.Y.Z tag) and attaches them to that GitHub Release; Claude Code
# installs track main through the marketplace instead.
*.plugin

# Pre-built release ZIPs stay untracked.
releases/*.zip
.claude-plugin/*.zip

# Calibrator + semantic-review + pre-flight session outputs. Per the
# v0.10.0 stage close-notes convention, these are session-scope and
# regenerated on every run; the latest.json convenience pointer is also
# session-scope. The .plugin-efficiency.json config at the repo root
# stays tracked (it's the calibrator config, not output).
artifacts/efficiency/
artifacts/runs/
artifacts/v0.10.0_preflight/
artifacts/semantic-review/

# Session-scope handoff documents. Per the project's prior-session
# convention these stay untracked; some older handoffs slipped into the
# tree before the convention was codified — drop them via git rm --cached.
.claude/handoffs/

# Session-specific review outputs. Reviewer-emitted templates that are
# part of the Reflector convention (e.g., reviews/plugin_update_proposals.md
# as the canonical example) stay tracked; per-session consultation /
# verification outputs do not.
reviews/advisor_consultation_*.md
reviews/ground_truth_verification_*.md
reviews/token_budget_report.json
reviews/findings.json

# Stray auditor output when run_all.py is invoked with cwd=scripts/audit/.
# The canonical findings.json lives at the project-root reviews/; this dir is
# a generated scratch artifact and must never be committed.
scripts/audit/reviews/

# (cleanup 2026-05-27) ignore local scratch dir. Claude-pack zips stay
# ignored (see Plugin bundles above).
scratch/

# Lawfully acquired local source texts are user-local inputs. They must never
# enter Git or either package builder.
references/resources/local/
