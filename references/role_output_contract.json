{
  "schema_version": "2.0.0",
  "contract_id": "role-output-contract",
  "path_contract_version": "2.0.0",
  "authorities": {
    "academic_deliverable_writer": "generator",
    "lifecycle_state_writer": "planner",
    "handoff_writer": "planner",
    "default_acceptance_authority": "user",
    "independent_review_writer": "evaluator",
    "reflection_writer": "reflector"
  },
  "path_namespaces": {
    "deliverables": "milestones",
    "handoffs": "reviews/.harness/handoffs",
    "snapshots": "reviews/.harness/snapshots"
  },
  "common_generator_outputs": [
    {"path": "manuscript/revision_log.md", "mode": "append"}
  ],
  "acceptance_model": "M1-M3 accept within Ph1; M4 remains mutable through Ph3 and freezes on acceptance; public FINAL maps only to ledger M5 and closes from Ph4",
  "milestones": {
    "M1": {
      "deliverable_writer": "generator",
      "deliverable_path": "milestones/M1_project_memo.md",
      "write_states": ["Ph1"],
      "acceptance_state": "Ph1",
      "evaluator_engagement": "bounded-independent-required",
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/handoffs/M1_to_M2.json"
    },
    "M2": {
      "deliverable_writer": "generator",
      "deliverable_path": "milestones/M2_annotated_references.md",
      "write_states": ["Ph1"],
      "acceptance_state": "Ph1",
      "evaluator_engagement": "bounded-independent-required",
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/handoffs/M2_to_M3.json"
    },
    "M3": {
      "deliverable_writer": "generator",
      "deliverable_path": "milestones/M3_argument_evidence_outline.md",
      "write_states": ["Ph1"],
      "acceptance_state": "Ph1",
      "content_scope": "structured-outline-only",
      "evaluator_engagement": "bounded-independent-required",
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/handoffs/M3_to_M4.json"
    },
    "M4": {
      "deliverable_writer": "generator",
      "deliverable_path": "milestones/M4_complete_paper_draft.md",
      "write_states": ["Ph1", "Ph2", "Ph3"],
      "initial_assembly_state": "Ph1",
      "normal_review_states": ["Ph2", "Ph3"],
      "acceptance_readiness": "Ph3_converged",
      "evaluator_engagement": "bounded-independent-at-Ph1-full-from-Ph2",
      "feedback_adjudication_required": true,
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/handoffs/M4_to_M5.json"
    },
    "M5": {
      "public_target": "FINAL",
      "deliverable_writer": "generator",
      "deliverable_path": "milestones/M5_final_paper.md",
      "released_export_path": "submission_bundle/final_manuscript.md",
      "write_states": ["Ph4"],
      "acceptance_state": "Ph4",
      "evaluator_engagement": "strict-final-required",
      "feedback_adjudication_required": true,
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/handoffs/M5_terminal.json"
    }
  },
  "specialization": {
    "authority": "user-or-higher-authority-project-contract",
    "must_be_explicit": true,
    "file_presence_never_specializes": true
  }
}
