{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipment_refusal_receipt.schema.json",
  "title": "Typed shipment refusal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "receipt_id", "created_at", "work_id", "run_id", "invocation_scope", "context", "diagnostic_code", "detail", "recoverable", "effect_scope"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_type": {"const": "shipment_refusal"},
    "receipt_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "work_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "invocation_scope": {"enum": ["adhoc_review", "lab_iteration", "full_lifecycle"]},
    "context": {"type": "object"},
    "diagnostic_code": {"type": "string", "minLength": 1},
    "detail": {"type": "string", "minLength": 1},
    "recoverable": {"type": "boolean"},
    "effect_scope": {"const": "proposal_only"}
  }
}
