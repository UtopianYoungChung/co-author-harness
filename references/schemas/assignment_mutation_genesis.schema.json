{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_mutation_genesis.schema.json",
  "title": "Assignment mutation genesis 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "genesis_type", "genesis_id", "state", "project", "ledger_path", "row_count", "head", "initial_targets", "policy_sha256", "corpus_digest", "issuer_transaction_id", "issued_at", "nonce"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "genesis_type": {"const": "assignment_mutation"},
    "genesis_id": {"type": "string", "pattern": "^genesis-[0-9a-f]{16}$"},
    "state": {"const": "committed"},
    "project": {"$ref": "#/$defs/root"},
    "ledger_path": {"$ref": "#/$defs/safePath"},
    "row_count": {"const": 0},
    "head": {"type": "null"},
    "initial_targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_digest": {"$ref": "#/$defs/sha256"},
    "issuer_transaction_id": {"type": "string", "minLength": 1},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32,64}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"},
    "root": {"type": "object", "additionalProperties": false, "required": ["kind", "identity", "discovery", "manifest_sha256"], "properties": {"kind": {"const": "project"}, "identity": {"type": "string", "minLength": 1}, "discovery": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["exists", "sha256", "size"], "properties": {"exists": {"type": "boolean"}, "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "size": {"type": "integer", "minimum": 0}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["path", "snapshot"], "properties": {"path": {"$ref": "#/$defs/safePath"}, "snapshot": {"$ref": "#/$defs/snapshot"}}}
  }
}
