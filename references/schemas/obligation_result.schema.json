{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/obligation_result.schema.json",
  "title": "Typed obligation result 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "obligation_id",
    "adapter_version",
    "artifact",
    "policy",
    "report",
    "activation",
    "execution_status",
    "outcome",
    "findings",
    "diagnostic_only",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "obligation_id": {"$ref": "#/$defs/id"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact": {"$ref": "#/$defs/binding"},
    "policy": {"$ref": "#/$defs/binding"},
    "report": {"$ref": "#/$defs/binding"},
    "verifier_receipt": {"$ref": "#/$defs/binding"},
    "activation_proof": {"$ref": "#/$defs/binding"},
    "activation": {"type": "string", "minLength": 1},
    "execution_status": {"enum": ["not_run", "completed", "failed", "not_applicable"]},
    "legacy_execution_evidence": {"$ref": "#/$defs/legacyExecutionEvidence"},
    "outcome": {"enum": ["clean", "findings", "error", "not_applicable"]},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "diagnostic_only": {"type": "boolean"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "adjudications": {
      "type": "array",
      "items": {"$ref": "obligation_adjudication.schema.json"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "clean"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "execution_status": {"const": "completed"},
          "findings": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "findings"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "execution_status": {"const": "completed"},
          "findings": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "error"}}, "required": ["outcome"]},
      "then": {"properties": {"execution_status": {"enum": ["not_run", "failed"]}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "not_applicable"}}, "required": ["outcome"]},
      "then": {
        "required": ["activation_proof"],
        "properties": {
          "execution_status": {"const": "not_applicable"},
          "findings": {"maxItems": 0}
        }
      },
      "else": {"not": {"required": ["activation_proof"]}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "evidence_identity", "fingerprint", "disposition"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR", "ADVISORY"]},
        "evidence_identity": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "disposition": {"enum": ["open", "resolved", "acknowledged", "escalated", "refused", "not_required"]}
      }
    },
    "adapterReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_type",
        "adapter_id",
        "adapter_version",
        "obligation_id",
        "artifact",
        "policy",
        "activation",
        "execution_status",
        "outcome",
        "findings",
        "diagnostic_only",
        "created_at"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "report_type": {"const": "obligation_adapter_report"},
        "adapter_id": {"$ref": "#/$defs/id"},
        "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "obligation_id": {"$ref": "#/$defs/id"},
        "artifact": {"$ref": "#/$defs/binding"},
        "policy": {"$ref": "#/$defs/binding"},
        "activation": {"type": "string", "minLength": 1},
        "execution_status": {"enum": ["not_run", "completed", "failed", "not_applicable"]},
        "outcome": {"enum": ["clean", "findings", "error", "not_applicable"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "diagnostic_only": {"type": "boolean"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "clean"}}, "required": ["outcome"]},
          "then": {"properties": {"execution_status": {"const": "completed"}, "findings": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "findings"}}, "required": ["outcome"]},
          "then": {"properties": {"execution_status": {"const": "completed"}, "findings": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "error"}}, "required": ["outcome"]},
          "then": {"properties": {"execution_status": {"enum": ["not_run", "failed"]}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "not_applicable"}}, "required": ["outcome"]},
          "then": {"properties": {"execution_status": {"const": "not_applicable"}, "findings": {"maxItems": 0}}}
        }
      ]
    },
    "legacyExecutionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "rationale"],
      "properties": {
        "status": {"const": "applied"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
