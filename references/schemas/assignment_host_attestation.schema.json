{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_host_attestation.schema.json",
  "title": "Assignment host attestation 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestation_type", "attestation_id", "issuer", "host_task_id", "host_session_id", "role", "dispatch_claim", "target", "artifact", "issued_at", "nonce", "authenticator"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "attestation_type": {"const": "host_dispatch_independence"},
    "attestation_id": {"type": "string", "pattern": "^host-[0-9a-f]{16}$"},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["name", "tool", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "tool": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "host_task_id": {"type": "string", "minLength": 1},
    "host_session_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["generator", "evaluator"]},
    "dispatch_claim": {"$ref": "#/$defs/binding"},
    "target": {"$ref": "#/$defs/safePath"},
    "artifact": {"$ref": "#/$defs/binding"},
    "generation_verifier": {"$ref": "#/$defs/binding"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32,64}$"},
    "authenticator": {"type": "object", "additionalProperties": false, "required": ["kind", "digest"], "properties": {"kind": {"enum": ["signature", "mac", "immutable_tool_receipt"]}, "digest": {"$ref": "#/$defs/sha256"}}}
  },
  "allOf": [
    {"if": {"properties": {"role": {"const": "generator"}}}, "then": {"not": {"required": ["generation_verifier"]}}},
    {"if": {"properties": {"role": {"const": "evaluator"}}}, "then": {"required": ["generation_verifier"]}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"},
    "root": {"type": "object", "additionalProperties": false, "required": ["kind", "identity", "discovery", "manifest_sha256"], "properties": {"kind": {"enum": ["project", "harness"]}, "identity": {"type": "string", "minLength": 1}, "discovery": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["root", "path", "sha256", "evidence_type"], "properties": {"root": {"$ref": "#/$defs/root"}, "path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "evidence_type": {"type": "string", "minLength": 1}}}
  }
}
