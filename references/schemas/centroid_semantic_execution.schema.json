{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/centroid_semantic_execution.schema.json",
  "title": "Role-produced centroid semantic execution receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "target",
    "phase",
    "role",
    "actor_id",
    "dispatch_id",
    "artifact",
    "centroid_packet",
    "passages",
    "semantic_assessment"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "receipt_type": {"const": "centroid_semantic_execution"},
    "target": {"enum": ["M1", "M2", "M3", "M4", "FINAL"]},
    "phase": {"enum": ["generation", "evaluation"]},
    "role": {"enum": ["generator", "evaluator"]},
    "actor_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "artifact": {"$ref": "#/$defs/binding"},
    "centroid_packet": {"$ref": "#/$defs/binding"},
    "generation_envelope": {"$ref": "#/$defs/binding"},
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_fingerprint", "code", "locator", "disposition", "rationale"],
        "properties": {
          "candidate_fingerprint": {"$ref": "#/$defs/sha256"},
          "code": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["accepted_synthesis", "false_positive", "resolved_in_bytes"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/passage"}
    },
    "semantic_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "strengths",
        "deviations",
        "warrant_limits",
        "actionable_findings"
      ],
      "properties": {
        "bibliography_review": {"type": "object", "description": "Complete source and citation-use assessment validated by scripts/bibliography_review.py; legacy absence is readable but cannot clear bibliography assurance."},
        "summary": {"type": "string", "minLength": 1},
        "strengths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "deviations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "warrant_limits": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "actionable_findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "generation"}}},
      "then": {
        "properties": {"role": {"const": "generator"}},
        "not": {"anyOf": [{"required": ["generation_envelope"]}, {"required": ["adjudications"]}]}
      },
      "else": {
        "properties": {"role": {"const": "evaluator"}},
        "required": ["generation_envelope", "adjudications"]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key",
        "use_scope",
        "source",
        "locator",
        "extract",
        "extraction",
        "quote",
        "citation",
        "use"
      ],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "use_scope": {"enum": ["surface", "argument"]},
        "source": {"$ref": "#/$defs/binding"},
        "locator": {"type": "string", "minLength": 1},
        "extract": {"$ref": "#/$defs/binding"},
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "tool", "canonical"],
          "properties": {
            "method": {"enum": ["pdftotext", "text-direct"]},
            "tool": {"type": "string", "minLength": 1},
            "canonical": {"const": true}
          }
        },
        "quote": {"type": "string", "minLength": 1},
        "citation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authors", "year", "title", "label"],
          "properties": {
            "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "year": {"type": "integer", "minimum": 1000, "maximum": 9999},
            "title": {"type": "string", "minLength": 1},
            "label": {"type": "string", "pattern": "^[1-9][0-9]{3}[a-z]?$"}
          }
        },
        "use": {"type": "string", "minLength": 1}
      }
    }
  }
}
