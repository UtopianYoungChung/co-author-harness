{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_gate_receipt.schema.json",
  "title": "Assignment Gate Receipt v2.1",
  "description": "Immutable, directory-state receipt authorizing one scoped Generator write transaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "reservation_id", "stage",
    "target_milestone", "authorized_role", "authorized_paths", "authorized_writes",
    "primary_deliverable_path", "project_root_name", "project_root_resolved", "produced_at",
    "authority", "gate_command", "gate_exit_code", "gate_stdout_sha256",
    "assignment_contract_sha256", "phase_state_sha256", "profile_sha256", "role_output_contract_sha256",
    "exemplar_conditioning", "active_lineage_id"
  ],
  "properties": {
    "schema_version": { "const": "2.1.0" },
    "receipt_id": { "type": "string", "format": "uuid" },
    "reservation_id": { "type": "string", "format": "uuid" },
    "stage": { "enum": ["draft", "final"] },
    "target_milestone": { "enum": ["M1", "M2", "M3", "M4", "FINAL"] },
    "authorized_role": { "const": "generator" },
    "authorized_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/safe_path" }
    },
    "authorized_writes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "mode"],
        "properties": {
          "path": { "$ref": "#/$defs/safe_path" },
          "mode": { "enum": ["create", "replace", "append"] }
        }
      }
    },
    "primary_deliverable_path": { "$ref": "#/$defs/safe_path" },
    "project_root_name": { "type": "string", "minLength": 1 },
    "project_root_resolved": { "type": "string", "minLength": 1 },
    "produced_at": { "$ref": "#/$defs/timestamp" },
    "authority": { "const": "planner" },
    "gate_command": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "gate_exit_code": { "const": 0 },
    "gate_stdout_sha256": { "$ref": "#/$defs/sha256" },
    "assignment_contract_sha256": { "$ref": "#/$defs/sha256" },
    "phase_state_sha256": { "$ref": "#/$defs/sha256" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "role_output_contract_sha256": { "$ref": "#/$defs/sha256" },
    "exemplar_conditioning": { "type": "boolean" },
    "active_lineage_id": { "type": "string", "minLength": 1 }
  },
  "allOf": [{
    "if": { "properties": { "stage": { "const": "final" } } },
    "then": { "properties": { "target_milestone": { "const": "FINAL" } } }
  }],
  "$defs": {
    "safe_path": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
