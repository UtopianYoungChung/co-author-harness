{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/product_assurance_detector_score.schema.json",
  "title": "Product assurance detector score 1.0.0",
  "$comment": "Common sha256 and fileBinding are reused where equivalent; the detector retains byte_length >= 1. Common safePath, timestamp, rootIdentity, and rootedBinding are non-equivalent or absent and are intentionally not applied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "split",
    "candidate_only",
    "judgment_truth_certified",
    "promotion_effect",
    "detector",
    "corpus",
    "freeze",
    "item_results",
    "per_code",
    "aggregate"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_type": {"const": "product_assurance_detector_score"},
    "split": {"enum": ["development", "held_out"]},
    "candidate_only": {"const": true},
    "judgment_truth_certified": {"const": false},
    "promotion_effect": {"const": "none"},
    "detector": {"$ref": "#/$defs/detectorBinding"},
    "corpus": {"$ref": "#/$defs/fileBinding"},
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "held_out_freeze_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/sha256"},
        "held_out_freeze_sha256": {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/sha256"}
      }
    },
    "item_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/itemResult"}
    },
    "per_code": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/matrix"}
    },
    "aggregate": {"$ref": "#/$defs/counts"}
  },
  "$defs": {
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
    "fileBinding": {
      "allOf": [
        {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/fileBinding"},
        {"properties": {"byte_length": {"minimum": 1}}}
      ]
    },
    "detectorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "sha256", "byte_length"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tp", "fp", "fn", "tn", "support", "predicted_positive", "precision", "recall"],
      "properties": {
        "tp": {"type": "integer", "minimum": 0},
        "fp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0},
        "tn": {"type": "integer", "minimum": 0},
        "support": {"type": "integer", "minimum": 0},
        "predicted_positive": {"type": "integer", "minimum": 0},
        "precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "tp", "fp", "fn", "tn", "support", "predicted_positive", "precision", "recall"],
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "tp": {"type": "integer", "minimum": 0},
        "fp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0},
        "tn": {"type": "integer", "minimum": 0},
        "support": {"type": "integer", "minimum": 0},
        "predicted_positive": {"type": "integer", "minimum": 0},
        "precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "labelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "expected_candidate", "observed_candidate", "outcome", "rationale"],
      "properties": {
        "code": {"$ref": "#/$defs/code"},
        "expected_candidate": {"type": "boolean"},
        "observed_candidate": {"type": "boolean"},
        "outcome": {"enum": ["TP", "FP", "FN", "TN"]},
        "rationale": {"type": "string", "minLength": 12}
      }
    },
    "itemResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_sha256", "corpus_sha256", "labels"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/sha256"},
        "corpus_sha256": {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/sha256"},
        "labels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/labelResult"}}
      }
    }
  }
}
