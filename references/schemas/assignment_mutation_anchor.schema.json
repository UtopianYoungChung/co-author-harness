{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_mutation_anchor.schema.json",
  "title": "Assignment mutation legacy anchor 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "anchor_type", "anchor_id", "state", "project", "ledger", "row_count", "head", "live_targets", "authorization", "adapter", "issued_at", "nonce", "authenticator", "historical_provenance_asserted"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "anchor_type": {"const": "assignment_mutation_legacy"},
    "anchor_id": {"type": "string", "pattern": "^anchor-[0-9a-f]{16}$"},
    "state": {"const": "committed"},
    "project": {"$ref": "#/$defs/root"},
    "ledger": {"$ref": "#/$defs/binding"},
    "row_count": {"type": "integer", "minimum": 0},
    "head": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "live_targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["authority", "evidence"], "properties": {"authority": {"enum": ["user", "research_governance"]}, "evidence": {"$ref": "#/$defs/binding"}}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["issuer", "tool", "version", "authorization_id"], "properties": {"issuer": {"type": "string", "minLength": 1}, "tool": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "authorization_id": {"type": "string", "minLength": 1}}},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32,64}$"},
    "authenticator": {"type": "object", "additionalProperties": false, "required": ["kind", "digest"], "properties": {"kind": {"enum": ["signature", "mac", "immutable_tool_receipt"]}, "digest": {"$ref": "#/$defs/sha256"}}},
    "historical_provenance_asserted": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"},
    "root": {"type": "object", "additionalProperties": false, "required": ["kind", "identity", "discovery", "manifest_sha256"], "properties": {"kind": {"const": "project"}, "identity": {"type": "string", "minLength": 1}, "discovery": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["root", "path", "sha256", "evidence_type"], "properties": {"root": {"$ref": "#/$defs/root"}, "path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "evidence_type": {"type": "string", "minLength": 1}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["exists", "sha256", "size"], "properties": {"exists": {"type": "boolean"}, "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "size": {"type": "integer", "minimum": 0}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["path", "snapshot"], "properties": {"path": {"$ref": "#/$defs/safePath"}, "snapshot": {"$ref": "#/$defs/snapshot"}}}
  }
}
