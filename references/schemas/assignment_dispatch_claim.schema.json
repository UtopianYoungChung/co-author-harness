{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_dispatch_claim.schema.json",
  "title": "Assignment dispatch claim 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_type", "claim_id", "claim_kind", "state", "role", "issued_at", "nonce", "issuer", "assignment_receipt", "receipt_id", "reservation", "reservation_id", "target_milestone", "target_path", "authorized_writes", "policy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "claim_type": {"const": "assignment_dispatch"},
    "claim_id": {"type": "string", "pattern": "^dispatch-[0-9a-f]{16}$"},
    "claim_kind": {"enum": ["generation", "evaluation"]},
    "state": {"const": "issued"},
    "role": {"enum": ["generator", "evaluator"]},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32,64}$"},
    "issuer": {"$ref": "#/$defs/issuer"},
    "assignment_receipt": {"$ref": "#/$defs/binding"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "reservation": {"$ref": "#/$defs/binding"},
    "reservation_id": {"type": "string", "format": "uuid"},
    "target_milestone": {"enum": ["M1", "M2", "M3", "M4", "FINAL"]},
    "target_path": {"$ref": "#/$defs/safePath"},
    "authorized_writes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/write"}},
    "policy": {"$ref": "#/$defs/binding"},
    "qualification_mode": {"enum": ["governed_v3", "graph_independent_v2"]},
    "canonical_bibliography_snapshot": {"$ref": "#/$defs/binding"},
    "corpus_digest": {"$ref": "#/$defs/sha256"},
    "reader_policy": {"$ref": "#/$defs/binding"},
    "semantic_usage": {"const": "not_invoked"},
    "generation_claim": {"$ref": "#/$defs/binding"},
    "generation_consumption": {"$ref": "#/$defs/binding"},
    "artifact": {"$ref": "#/$defs/binding"},
    "generation_verifier": {"$ref": "#/$defs/generationVerifier"}
  },
  "allOf": [
    {"if": {"properties": {"claim_kind": {"const": "generation"}}}, "then": {"properties": {"role": {"const": "generator"}}, "not": {"anyOf": [{"required": ["generation_claim"]}, {"required": ["generation_consumption"]}, {"required": ["artifact"]}, {"required": ["generation_verifier"]}]}}},
    {"if": {"properties": {"claim_kind": {"const": "evaluation"}}}, "then": {"properties": {"role": {"const": "evaluator"}}, "required": ["generation_claim", "generation_consumption", "artifact", "generation_verifier"]}},
    {"if": {"properties": {"qualification_mode": {"const": "graph_independent_v2"}}, "required": ["qualification_mode"]}, "then": {"required": ["reader_policy", "semantic_usage"], "not": {"anyOf": [{"required": ["canonical_bibliography_snapshot"]}, {"required": ["corpus_digest"]}]}}, "else": {"required": ["canonical_bibliography_snapshot", "corpus_digest"], "not": {"anyOf": [{"required": ["reader_policy"]}, {"required": ["semantic_usage"]}]}}}
  ],
  "$defs": {
    "sha256": {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/sha256"},
    "timestamp": {"allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/timestamp"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}]},
    "safePath": {"allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/safePath"}, {"type": "string", "pattern": "^(?!.*:).+$"}]},
    "root": {"allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/rootIdentity"}, {"type": "object", "properties": {"kind": {"enum": ["project", "harness", "wiki"]}}}]},
    "binding": {"allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/rootedBinding"}, {"type": "object", "properties": {"root": {"$ref": "#/$defs/root"}, "path": {"$ref": "#/$defs/safePath"}}}]},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["exists", "sha256", "size"], "properties": {"exists": {"type": "boolean"}, "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "size": {"type": "integer", "minimum": 0}}},
    "write": {"type": "object", "additionalProperties": false, "required": ["path", "mode", "preimage"], "properties": {"path": {"$ref": "#/$defs/safePath"}, "mode": {"enum": ["create", "replace", "append"]}, "preimage": {"$ref": "#/$defs/snapshot"}}},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["name", "version", "transaction_id"], "properties": {"name": {"const": "assignment_transaction_kernel"}, "version": {"const": "1.0.0"}, "transaction_id": {"type": "string", "minLength": 1}}},
    "generationVerifier": {"type": "object", "additionalProperties": false, "required": ["transaction_id", "transaction", "publication_manifest", "commit_marker", "product_disposition"], "allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/publicationChain"}], "properties": {"transaction_id": {"type": "string", "pattern": "^verifier-[0-9a-f]{16}$"}, "transaction": {"$ref": "#/$defs/binding"}, "publication_manifest": {"$ref": "#/$defs/binding"}, "commit_marker": {"$ref": "#/$defs/binding"}, "product_disposition": {"const": "evaluation_ready"}}}
  }
}
