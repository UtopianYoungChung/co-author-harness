{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consumer_compatibility_profile.schema.json",
  "title": "Immutable producer/consumer compatibility tuple",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "binding_state", "producer", "contract_kernel", "shipment_schema", "output_contract", "compatibility_kit", "fixture_corpus", "consumer", "external_snapshot", "scope_binding", "occurrence_rules", "diagnostic_map_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "binding_state": {"enum": ["template", "resolved"]},
    "producer": {"$ref": "#/$defs/versionedCommit"},
    "contract_kernel": {"$ref": "#/$defs/versionedHash"},
    "shipment_schema": {"$ref": "#/$defs/versionedHash"},
    "output_contract": {"allOf": [{"$ref": "#/$defs/versionedHash"}, {"type": "object", "required": ["id"], "properties": {"id": {"const": "role-output-contract"}}}]},
    "compatibility_kit": {"$ref": "#/$defs/hash"},
    "fixture_corpus": {"type": "object", "additionalProperties": false, "required": ["sha256", "fixture_ids"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "fixture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "consumer": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/consumerTuple"}]},
    "external_snapshot": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "scope_binding": {"type": "object", "additionalProperties": false, "required": ["work_id", "activation_baseline_sha256", "canonical_role_registry_sha256", "invocation_scope"], "properties": {"work_id": {"type": ["string", "null"], "minLength": 1}, "activation_baseline_sha256": {"$ref": "#/$defs/nullableSha256"}, "canonical_role_registry_sha256": {"$ref": "#/$defs/nullableSha256"}, "invocation_scope": {"type": ["string", "null"], "enum": ["adhoc_review", "lab_iteration", "full_lifecycle", null]}}},
    "occurrence_rules": {"type": "object", "additionalProperties": false, "required": ["canonicalization", "deduplication_key"], "properties": {"canonicalization": {"const": "compact-key-sorted-utf8-json+nfc+windows-casefold-paths"}, "deduplication_key": {"const": "occurrence_id"}}},
    "diagnostic_map_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"binding_state": {"const": "resolved"}}, "required": ["binding_state"]},
      "then": {
        "properties": {
          "producer": {"properties": {"commit": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}}},
          "scope_binding": {"properties": {"work_id": {"type": "string", "minLength": 1}, "activation_baseline_sha256": {"$ref": "#/$defs/sha256"}, "canonical_role_registry_sha256": {"$ref": "#/$defs/sha256"}, "invocation_scope": {"enum": ["adhoc_review", "lab_iteration", "full_lifecycle"]}}},
          "consumer": {"$ref": "#/$defs/consumerTuple"},
          "external_snapshot": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "producer": {"properties": {"commit": {"type": "null"}, "tree": {"type": "null"}}},
          "scope_binding": {"properties": {"work_id": {"type": "null"}, "activation_baseline_sha256": {"type": "null"}, "canonical_role_registry_sha256": {"type": "null"}, "invocation_scope": {"type": "null"}}},
          "consumer": {"type": "null"},
          "external_snapshot": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hash": {"type": "object", "additionalProperties": false, "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}},
    "versionedHash": {"type": "object", "additionalProperties": false, "required": ["version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "versionedCommit": {"type": "object", "additionalProperties": false, "required": ["name", "version", "commit", "tree"], "properties": {"name": {"const": "co-author-harness"}, "version": {"type": "string", "minLength": 1}, "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}}},
    "consumerTuple": {"type": "object", "additionalProperties": false, "required": ["name", "guard", "policy", "config", "tests"], "properties": {"name": {"type": "string", "minLength": 1}, "guard": {"$ref": "#/$defs/versionedHash"}, "policy": {"$ref": "#/$defs/versionedHash"}, "config": {"$ref": "#/$defs/versionedHash"}, "tests": {"$ref": "#/$defs/versionedHash"}}}
  }
}
