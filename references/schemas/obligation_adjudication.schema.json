{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/obligation_adjudication.schema.json",
  "title": "Obligation finding adjudication 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adjudication_id",
    "obligation_id",
    "finding_fingerprint",
    "artifact",
    "disposition",
    "authority",
    "authority_receipt",
    "rationale",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "adjudication_id": {"$ref": "#/$defs/id"},
    "obligation_id": {"$ref": "#/$defs/id"},
    "finding_fingerprint": {"$ref": "#/$defs/sha256"},
    "artifact": {"$ref": "#/$defs/binding"},
    "disposition": {"enum": ["resolved", "acknowledged", "escalated", "refused", "not_required"]},
    "authority": {"type": "string", "minLength": 1},
    "authority_receipt": {"$ref": "#/$defs/binding"},
    "rationale": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "resolution_verification": {"$ref": "#/$defs/resolutionVerification"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "resolved"}}, "required": ["disposition"]},
      "then": {"required": ["resolution_verification"]},
      "else": {"not": {"required": ["resolution_verification"]}}
    },
    {
      "if": {"properties": {"disposition": {"const": "escalated"}}, "required": ["disposition"]},
      "then": {"required": ["owner"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "resolutionVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "artifact_byte_length", "finding_fingerprint", "verified"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_byte_length": {"type": "integer", "minimum": 0},
        "finding_fingerprint": {"$ref": "#/$defs/sha256"},
        "verified": {"const": true}
      }
    }
  }
}
