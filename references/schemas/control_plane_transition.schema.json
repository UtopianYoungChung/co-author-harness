{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/control_plane_transition.schema.json",
  "title": "Atomic control-plane transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "state",
    "project_root",
    "destination_capability",
    "active_target",
    "members",
    "superseded_authority",
    "preimage_digest",
    "postimage_digest",
    "journal",
    "publication_manifest",
    "commit_marker"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "state": {
      "enum": [
        "prepared",
        "validated",
        "publishing",
        "committed",
        "recovery_required",
        "invalidated"
      ]
    },
    "project_root": {"type": "string", "minLength": 1},
    "destination_capability": {
      "enum": ["package", "governed_staging", "private_shipment"]
    },
    "active_target": {"$ref": "#/$defs/current_binding"},
    "members": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/member"}
    },
    "superseded_authority": {
      "type": "array",
      "items": {"$ref": "#/$defs/superseded_authority"}
    },
    "preimage_digest": {"$ref": "#/$defs/sha256"},
    "postimage_digest": {"$ref": "#/$defs/sha256"},
    "journal": {"$ref": "#/$defs/journal"},
    "publication_manifest": {"$ref": "#/$defs/publication_manifest"},
    "commit_marker": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/current_binding"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "committed"}}, "required": ["state"]},
      "then": {"properties": {"commit_marker": {"$ref": "#/$defs/current_binding"}}},
      "else": {"properties": {"commit_marker": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*[\\\\:<>\"|?*\\u0000-\\u001F])(?!(?:\\.|\\.\\.)(?:/|$))(?!.*\\/(?:\\.|\\.\\.)(?:/|$))(?![^/]*[. ](?:/|$))(?!.*\\/[^/]*[. ](?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])[ .]*(?:[.]|/|$))(?!.*\\/(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])[ .]*(?:[.]|/|$))[^/]+(?:/[^/]+)*$"
    },
    "current_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "sha256", "byte_length"],
      "properties": {
        "exists": {"type": "boolean"},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "byte_length": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"exists": {"const": true}}, "required": ["exists"]},
          "then": {
            "properties": {
              "sha256": {"$ref": "#/$defs/sha256"},
              "byte_length": {"type": "integer", "minimum": 0}
            }
          },
          "else": {
            "properties": {
              "sha256": {"type": "null"},
              "byte_length": {"type": "null"}
            }
          }
        }
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member",
        "control_revision",
        "path",
        "preimage",
        "postimage",
        "publication_mode"
      ],
      "properties": {
        "member": {
          "enum": [
            "controlling_brief",
            "directives",
            "active_target",
            "round_program",
            "revision_plan",
            "assignment_source_binding",
            "reader_policy_binding",
            "affected_receipts_and_evaluations"
          ]
        },
        "control_revision": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/path"},
        "preimage": {"$ref": "#/$defs/image"},
        "postimage": {"$ref": "#/$defs/image"},
        "publication_mode": {"enum": ["create", "replace", "delete"]}
      }
    },
    "superseded_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "authority_kind", "pre_state", "post_state"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "authority_kind": {"enum": ["receipt", "evaluation"]},
        "pre_state": {"type": "string", "minLength": 1},
        "post_state": {"const": "invalidated"}
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "events"],
      "properties": {
        "state": {"enum": ["prepared", "validated", "publishing", "committed", "recovery_required"]},
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "publication_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "member_publications", "invalidations", "completed_effects"],
      "properties": {
        "state": {"enum": ["candidate", "publishing", "published", "recovery_required"]},
        "member_publications": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/member_publication"}
        },
        "invalidations": {
          "type": "array",
          "items": {"$ref": "#/$defs/invalidation"}
        },
        "completed_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "member_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member", "path", "staged_path", "postimage"],
      "properties": {
        "member": {
          "enum": [
            "controlling_brief",
            "directives",
            "active_target",
            "round_program",
            "revision_plan",
            "assignment_source_binding",
            "reader_policy_binding",
            "affected_receipts_and_evaluations"
          ]
        },
        "path": {"$ref": "#/$defs/path"},
        "staged_path": {
          "oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]
        },
        "postimage": {"$ref": "#/$defs/image"}
      }
    },
    "invalidation_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "preimage", "postimage"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "preimage": {"$ref": "#/$defs/image"},
        "postimage": {"$ref": "#/$defs/image"}
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "authority_kind",
        "pre_state",
        "post_state",
        "source",
        "destination",
        "staged_path"
      ],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "authority_kind": {"enum": ["receipt", "evaluation"]},
        "pre_state": {"const": "ready"},
        "post_state": {"const": "invalidated"},
        "source": {"$ref": "#/$defs/invalidation_side"},
        "destination": {"$ref": "#/$defs/invalidation_side"},
        "staged_path": {"$ref": "#/$defs/path"}
      }
    }
  }
}
