{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/run_product_gate_manifest.schema.json",
  "title": "Governed product-gate run manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "run_id", "state", "mode", "lifecycle_eligible", "requested_checks", "inputs", "verifier_transaction", "runtime_versions", "omissions", "dispositions", "outputs", "recovery_command", "terminal_state"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_type": {"const": "product_gate_run"},
    "run_id": {"type": "string", "pattern": "^product-gate-[0-9a-f]{16}$"},
    "state": {"const": "prepared"},
    "mode": {"enum": ["mechanics", "governed-product"]},
    "lifecycle_eligible": {"type": "boolean"},
    "requested_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["deterministic-audit-suite", "semantic-product-verifier"]}},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "verifier_transaction": {"oneOf": [{"$ref": "#/$defs/verifier"}, {"type": "null"}]},
    "runtime_versions": {"$ref": "#/$defs/runtimeVersions"},
    "omissions": {"type": "array", "items": {"$ref": "#/$defs/omission"}},
    "dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/disposition"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
    "recovery_command": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "terminal_state": {"enum": ["diagnostic_complete", "product_qualified"]}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "mechanics"}}}, "then": {"properties": {"lifecycle_eligible": {"const": false}, "verifier_transaction": {"type": "null"}, "terminal_state": {"const": "diagnostic_complete"}}}},
    {"if": {"properties": {"mode": {"const": "governed-product"}}}, "then": {"properties": {"lifecycle_eligible": {"const": true}, "verifier_transaction": {"$ref": "#/$defs/verifier"}, "terminal_state": {"const": "product_qualified"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "size"], "properties": {"kind": {"enum": ["governed_artifact", "semantic_receipt", "verifier_transaction", "verifier_publication_manifest", "verifier_commit_marker", "semantics_manifest", "wiki_root_manifest", "project_root_manifest"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0}}},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["transaction_id", "phase", "product_disposition", "transaction_sha256", "publication_manifest_sha256", "commit_marker_sha256"], "properties": {"transaction_id": {"type": "string", "pattern": "^verifier-[0-9a-f]{16}$"}, "phase": {"const": "evaluation"}, "product_disposition": {"const": "product_qualified"}, "transaction_sha256": {"$ref": "#/$defs/sha256"}, "publication_manifest_sha256": {"$ref": "#/$defs/sha256"}, "commit_marker_sha256": {"$ref": "#/$defs/sha256"}}},
    "runtimeVersions": {"type": "object", "additionalProperties": false, "required": ["extractor", "detector"], "properties": {"extractor": {"type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}, "detector": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}}},
    "omission": {"type": "object", "additionalProperties": false, "required": ["check", "reason"], "properties": {"check": {"enum": ["deterministic-audit-suite", "semantic-product-verifier"]}, "reason": {"type": "string", "minLength": 1}}},
    "disposition": {"type": "object", "additionalProperties": false, "required": ["check", "status", "detail"], "properties": {"check": {"enum": ["deterministic-audit-suite", "semantic-product-verifier"]}, "status": {"enum": ["diagnostic", "qualified"]}, "detail": {"type": "string", "minLength": 1}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["kind", "sha256", "status"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["diagnostic", "qualified"]}}}
  }
}
