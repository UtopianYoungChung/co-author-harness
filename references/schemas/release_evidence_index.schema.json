{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/release_evidence_index.schema.json",
  "title": "Release evidence index 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "index_type", "release_version", "sequence",
    "created_at", "prior_index", "source", "package_index", "artifacts",
    "evidence", "planes", "warnings", "omissions", "no_claims",
    "reviewer", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "index_type": {"enum": ["package", "release"]},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "prior_index": {"oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "branch", "origin_main", "remote_main"],
      "properties": {
        "commit": {"$ref": "#/$defs/gitHash"},
        "tree": {"$ref": "#/$defs/gitHash"},
        "branch": {"const": "main"},
        "origin_main": {"$ref": "#/$defs/gitHash"},
        "remote_main": {"$ref": "#/$defs/gitHash"}
      }
    },
    "package_index": {"oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/namedBinding"}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "uniqueItems": true},
    "planes": {"type": "array", "items": {"$ref": "#/$defs/plane"}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "omissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "no_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reviewer": {"oneOf": [{"$ref": "#/$defs/reviewer"}, {"type": "null"}]},
    "status": {"enum": ["IMPLEMENTED", "PACKAGE_CLEARED", "SHIPPED", "HOST_QUALIFICATION_PENDING", "HOST_QUALIFICATION_FAILED", "HOST_QUALIFIED"]}
  },
  "allOf": [
    {
      "if": {"properties": {"index_type": {"const": "package"}}},
      "then": {"properties": {"package_index": {"type": "null"}, "prior_index": {"type": "null"}, "sequence": {"const": 1}}}
    },
    {
      "if": {"properties": {"index_type": {"const": "release"}}},
      "then": {"properties": {"package_index": {"$ref": "#/$defs/binding"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitHash": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "namedBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256", "result"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "result": {"enum": ["PASS", "QUALIFIED", "NOT_QUALIFIED", "PENDING", "OMITTED", "WARNING"]}
      }
    },
    "plane": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "receipt"],
      "properties": {
        "name": {"enum": ["source", "archive", "unpacked_zip", "codex_cache", "cowork_cache"]},
        "status": {"enum": ["qualified", "qualified_with_caveats", "pending", "failed", "not_applicable"]},
        "receipt": {"oneOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]}
      }
    },
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "verdict", "report"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["QUALIFIED", "NOT_QUALIFIED"]},
        "report": {"$ref": "#/$defs/binding"}
      }
    }
  }
}
