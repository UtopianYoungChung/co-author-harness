{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role_output_contract.schema.json",
  "title": "Role and typed-output contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "path_contract_version", "authorities", "path_namespaces", "output_populations", "invocation_scopes", "context_kinds", "suppression_reasons", "path_rules", "occurrence_identity", "common_generator_outputs", "fixed_roles", "triggered_output_classes", "classification_rules", "acceptance_model", "milestones", "specialization"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "contract_id": {"const": "role-output-contract"},
    "path_contract_version": {"const": "2.0.0"},
    "authorities": {"type": "object"},
    "path_namespaces": {"type": "object"},
    "output_populations": {"const": ["fixed_role", "triggered_class"]},
    "invocation_scopes": {"const": ["adhoc_review", "lab_iteration", "full_lifecycle"]},
    "context_kinds": {"const": ["round", "milestone", "package"]},
    "suppression_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "path_rules": {"type": "object", "required": ["separator", "unicode_normalization", "comparison", "require_lexical_and_resolved_containment", "reject_absolute_drive_unc_device_traversal", "reject_links_junctions_reparse_points"]},
    "occurrence_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "fields"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "compact-key-sorted-utf8-json+nfc+terminal-lf"},
        "fields": {"const": ["contract_id", "contract_version", "contract_sha256", "work_id", "invocation_scope", "class_id", "trigger_id", "context", "ordinal", "triggering_evidence_sha256"]}
      }
    },
    "common_generator_outputs": {"type": "array"},
    "fixed_roles": {"type": "object", "minProperties": 6, "additionalProperties": {"$ref": "#/$defs/fixedRole"}},
    "triggered_output_classes": {"type": "object", "minProperties": 9, "maxProperties": 9, "additionalProperties": {"$ref": "#/$defs/triggeredClass"}},
    "classification_rules": {"type": "object"},
    "acceptance_model": {"type": "string", "minLength": 1},
    "milestones": {"type": "object", "required": ["M1", "M2", "M3", "M4", "M5"]},
    "specialization": {"type": "object", "required": ["authority", "must_be_explicit", "file_presence_never_specializes"]}
  },
  "$defs": {
    "fixedRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writer", "current_path", "context_kinds", "operations", "payload_schema", "authorization_rule"],
      "properties": {
        "writer": {"type": "string", "minLength": 1},
        "current_path": {"type": "string", "minLength": 1},
        "context_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["round", "milestone", "package"]}},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["create", "modify", "append"]}},
        "payload_schema": {"type": "string", "minLength": 1},
        "authorization_rule": {"type": "string", "minLength": 1}
      }
    },
    "triggeredClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writer", "trigger_id", "event_type", "context_kinds", "invocation_scopes", "path_template", "cardinality", "ordering", "persistence", "human_facing", "payload_schema", "authorization_rule"],
      "properties": {
        "writer": {"type": "string", "minLength": 1},
        "trigger_id": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "context_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["round", "milestone", "package"]}},
        "invocation_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["adhoc_review", "lab_iteration", "full_lifecycle"]}},
        "path_template": {"type": "string", "minLength": 1},
        "cardinality": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "counting_scope"], "properties": {"minimum": {"type": "integer", "minimum": 0}, "maximum": {"type": ["integer", "null"], "minimum": 1}, "counting_scope": {"type": "string", "minLength": 1}}},
        "ordering": {"type": "string", "minLength": 1},
        "persistence": {"enum": ["immutable", "append", "current"]},
        "human_facing": {"type": "boolean"},
        "payload_schema": {"type": "string", "minLength": 1},
        "authorization_rule": {"type": "string", "minLength": 1}
      }
    }
  }
}
