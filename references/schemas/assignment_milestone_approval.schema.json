{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_milestone_approval.schema.json",
  "title": "Explicit milestone approval evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "milestone", "authority", "approved_at", "deliverable"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "approved"},
    "milestone": {"enum": ["M1", "M2", "M3", "M4", "M5"]},
    "authority": {"enum": ["user", "venue", "advisor", "instructor", "committee", "project_local_contract"]},
    "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "deliverable": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
