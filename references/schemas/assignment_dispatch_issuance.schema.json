{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_dispatch_issuance.schema.json",
  "title": "Assignment dispatch issuance ledger row 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/chainLink"}
  ],
  "required": [
    "schema_version",
    "issuance_type",
    "sequence",
    "prior_row_sha256",
    "claim",
    "claim_id",
    "claim_sha256",
    "claim_kind",
    "receipt_id",
    "reservation_id",
    "issuer",
    "issued_at",
    "publication_manifest",
    "commit_marker",
    "kernel_authorization",
    "authorization_id",
    "row_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "issuance_type": {"const": "assignment_dispatch_claim"},
    "sequence": {},
    "prior_row_sha256": {},
    "claim": {"$ref": "#/$defs/binding"},
    "claim_id": {"type": "string", "pattern": "^dispatch-[0-9a-f]{16}$"},
    "claim_sha256": {"$ref": "#/$defs/sha256"},
    "claim_kind": {"enum": ["generation", "evaluation"]},
    "receipt_id": {"type": "string", "format": "uuid"},
    "reservation_id": {"type": "string", "format": "uuid"},
    "issuer": {"$ref": "#/$defs/issuer"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "publication_manifest": {"$ref": "#/$defs/binding"},
    "commit_marker": {"$ref": "#/$defs/binding"},
    "kernel_authorization": {"$ref": "#/$defs/binding"},
    "authorization_id": {"type": "string", "format": "uuid"},
    "row_sha256": {}
  },
  "$defs": {
    "sha256": {"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/sha256"},
    "timestamp": {"allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/timestamp"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}]},
    "safePath": {"allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/safePath"}, {"type": "string", "pattern": "^(?!.*:).+$"}]},
    "root": {"allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/rootIdentity"}, {"type": "object", "properties": {"kind": {"enum": ["project", "harness", "wiki"]}}}]},
    "binding": {"allOf": [{"$ref": "https://co-author-harness.local/schemas/common_scholarly_primitives.schema.json#/$defs/rootedBinding"}, {"type": "object", "properties": {"root": {"$ref": "#/$defs/root"}, "path": {"$ref": "#/$defs/safePath"}}}]},
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "transaction_id"],
      "properties": {
        "name": {"const": "assignment_transaction_kernel"},
        "version": {"const": "1.0.0"},
        "transaction_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
