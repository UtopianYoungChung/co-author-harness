{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_dispatch_issuance.schema.json",
  "title": "Assignment dispatch issuance ledger row 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issuance_type",
    "sequence",
    "prior_row_sha256",
    "claim",
    "claim_id",
    "claim_sha256",
    "claim_kind",
    "receipt_id",
    "reservation_id",
    "issuer",
    "issued_at",
    "publication_manifest",
    "commit_marker",
    "kernel_authorization",
    "authorization_id",
    "row_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "issuance_type": {"const": "assignment_dispatch_claim"},
    "sequence": {"type": "integer", "minimum": 1},
    "prior_row_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "claim": {"$ref": "#/$defs/binding"},
    "claim_id": {"type": "string", "pattern": "^dispatch-[0-9a-f]{16}$"},
    "claim_sha256": {"$ref": "#/$defs/sha256"},
    "claim_kind": {"enum": ["generation", "evaluation"]},
    "receipt_id": {"type": "string", "format": "uuid"},
    "reservation_id": {"type": "string", "format": "uuid"},
    "issuer": {"$ref": "#/$defs/issuer"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "publication_manifest": {"$ref": "#/$defs/binding"},
    "commit_marker": {"$ref": "#/$defs/binding"},
    "kernel_authorization": {"$ref": "#/$defs/binding"},
    "authorization_id": {"type": "string", "format": "uuid"},
    "row_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "discovery", "manifest_sha256"],
      "properties": {
        "kind": {"enum": ["project", "harness", "wiki"]},
        "identity": {"type": "string", "minLength": 1},
        "discovery": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path", "sha256", "evidence_type"],
      "properties": {
        "root": {"$ref": "#/$defs/root"},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "evidence_type": {"type": "string", "minLength": 1}
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "transaction_id"],
      "properties": {
        "name": {"const": "assignment_transaction_kernel"},
        "version": {"const": "1.0.0"},
        "transaction_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
