{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_m4_acceptance_policy.schema.json",
  "title": "M4 acceptance-time current-manuscript policy binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "milestone", "manuscript_sha256", "phase", "cycle_id",
    "check8_path", "check8_sha256", "aggregate_verdict"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "milestone": {"const": "M4"},
    "manuscript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {"const": "Ph3"},
    "cycle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "check8_path": {"type": "string", "minLength": 1},
    "check8_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aggregate_verdict": {"enum": ["CLEAN", "BORDERLINE"]}
  }
}
