{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/token_budget_policy.schema.json",
  "title": "Token budget ratchet policy 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "encoder", "load_graph", "classes", "ownership", "baseline", "exceptions"],
  "properties": {
    "schema_version": {"const": "token-budget-policy/1.0.0"},
    "owner": {"type": "string", "minLength": 1},
    "encoder": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "version", "encoding"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "encoding": {"type": "string", "minLength": 1}
      }
    },
    "load_graph": {
      "type": "object", "additionalProperties": false,
      "required": ["graph_id", "always_loaded"],
      "properties": {
        "graph_id": {"const": "package-invocation-v1"},
        "always_loaded": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "classes": {
      "type": "object", "additionalProperties": false,
      "required": ["agents", "references (non-snippet)", "skills", "snippets"],
      "properties": {
        "agents": {"$ref": "#/$defs/classBudget"},
        "references (non-snippet)": {"$ref": "#/$defs/classBudget"},
        "skills": {"$ref": "#/$defs/classBudget"},
        "snippets": {"$ref": "#/$defs/classBudget"}
      }
    },
    "ownership": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["prefix", "owner"],
        "properties": {
          "prefix": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "commit", "tree", "total_files", "breaches", "always_loaded_floor_tokens"],
      "properties": {
        "kind": {"const": "immutable_git_tree"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "total_files": {"type": "integer", "minimum": 1},
        "breaches": {"type": "integer", "minimum": 0},
        "always_loaded_floor_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "owner", "expires_at", "max_tokens", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "expires_at": {"type": "string", "format": "date-time"},
          "max_tokens": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "classBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["warn_tokens", "fail_tokens"],
      "properties": {
        "warn_tokens": {"type": "integer", "minimum": 1},
        "fail_tokens": {"type": "integer", "minimum": 2}
      }
    }
  }
}
