{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reader_accessibility_profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "decision_status", "decision_record", "decision_approval", "normative_authority", "package_contributors", "policy_telos", "domain_native_register", "phase_values", "passage_roles", "sub_checks", "aggregate", "adjacent_advisory_checks", "thresholds", "transitions", "runtime_modes", "register_scope", "lexicons", "domain_token_exclusions", "override_contract", "remediation_order", "recurrence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_version": {"type": "string", "pattern": "^1\\.0\\.[0-9]+$"},
    "decision_status": {"const": "accepted"},
    "decision_record": {"const": "ADR-ACCESS-01"},
    "decision_approval": {"const": {"authority": "user", "approved_at": "2026-07-13", "provenance": "user_approval_in_session"}},
    "normative_authority": {"const": "references/READER_ACCESSIBILITY.md"},
    "package_contributors": {"const": ["references/READER_ACCESSIBILITY.md", "references/examples/model_prose_corpus.md"]},
    "policy_telos": {"type": "string", "minLength": 20},
    "domain_native_register": {
      "type":"object","additionalProperties":false,
      "required":["reader_model","corpus_binding","exemplar_members","exemplar_pending_grounding","warrant_layers","c7_fence","derivations","honesty_constraints","expected_verification"],
      "properties":{
        "reader_model":{"$ref":"#/$defs/readerModel"},
        "corpus_binding":{"type":"object","additionalProperties":false,"required":["path_roots","graph","pin","related_to_RE_predicate","hash_recipe","views"],"properties":{"path_roots":{"const":{"wiki_root":"B:/Agents/knowledge/LLM wiki","workspace_root":"B:/Agents","harness_root":"B:/Agents/platform/co-author-harness"}},"graph":{"type":"object","additionalProperties":false,"required":["path","role","observed_sha256_at_review"],"properties":{"path":{"const":"knowledge/LLM wiki/graphify-out/graph.json"},"role":{"const":"index and provenance metadata only; never a gate target"},"observed_sha256_at_review":{"$ref":"#/$defs/sha"}}},"pin":{"type":"object","additionalProperties":false,"required":["level","algorithm","pinned_objects","mf_policy_binding_keys","recorded_provenance","repin_policy"],"properties":{"level":{"const":"semantic"},"algorithm":{"const":"SHA-256 over UTF-8 bytes, lowercase hex"},"pinned_objects":{"const":["attestation_view_pin","exemplar_view_pin"]},"mf_policy_binding_keys":{"const":{"profile_sha256":"profile_sha256","attestation_view_pin":"attestation_view_pin","exemplar_view_pin":"exemplar_view_pin","graph_sha256_provenance":"graph_sha256_provenance"}},"recorded_provenance":{"const":["graph_sha256_provenance","graph_mtime_utc_provenance","unresolved_seed_ids"]},"repin_policy":{"const":"recompute at milestone transitions and grounded-source-admitting rounds; auto-accept no delta; real delta requires deliberate versioned repin; never intra-cycle"}}},"related_to_RE_predicate":{"type":"object","additionalProperties":false,"required":["seed_resolution","primary_communities","import_neighbors","membership","degeneracy_guard","link_contract"],"properties":{"seed_resolution":{"const":["exact_id","source_file_join","prefer_document_or_source","prefer_id_suffix_source","utf8_lexicographic_first"]},"primary_communities":{"const":"unique integer communities of resolved seeds"},"import_neighbors":{"const":"one hop outside primary communities from a primary-community member"},"membership":{"const":"union_primary_communities_and_one_hop_import_neighbors"},"degeneracy_guard":{"const":{"resolved_seed_count_lte":3,"primary_communities_lt":2,"effect":"warning_only"}},"link_contract":{"const":"source and target canonical; mandatory _src and _tgt must identify the same ordered or reversed endpoint pair"}}},"hash_recipe":{"const":{"attestation_view_pin":"newline join UTF-8-byte-sorted membership ids without trailing newline","exemplar_view_pin":"newline join UTF-8-byte-sorted source_key TAB normalized tier TAB source-page source_loc PDF sha256-or-dash tuples without trailing newline","normalize_tier":"strip whitespace-delimited em dash, en dash, or ASCII hyphen annotation; map full-text-pass to full-read and section-read-verified to section-read","pdf_staging_rule":"resolve source_loc from each contained wiki source page; missing PDF is dash; staging or byte change is a semantic delta"}},"views":{"const":{"attestation":{"role":"negative check: is this construction foreign?","members":"related_to_RE_predicate membership","absence_effect":"advisory_candidate_only"},"exemplar":{"role":"positive domain-native target","members":"exemplar_members admitted by deny list","admission":"deny normalized stub and unresolved; admit every other tier"}}}}},
        "exemplar_members":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["source_key","role","grounding"],"properties":{"source_key":{"type":"string","minLength":1,"pattern":"^[a-z0-9][a-z0-9-]*$"},"role":{"enum":["centroid","classic-halo","recent-yu","re-canon","istar-extension-halo","intentional-root"]},"grounding":{"type":"string","minLength":1},"warrant_scope":{"enum":["both","argument-only"]},"pdf":{"type":"string","minLength":1},"pdf_sha256":{"$ref":"#/$defs/sha"},"note":{"type":"string","minLength":1}}}},
        "exemplar_pending_grounding":{"const":[]},
        "warrant_layers":{"const":{"surface":{"question":"is this term, phrase, connective, or sentence shape attested?","sources":["exemplar PDFs","lawfully available source texts","attestation graph vocabulary"],"hosts":["Sub-check H","humanizer/lexicon layer"]},"argument":{"question":"is this derivation or logic-connection an insider move?","sources":["exemplar wiki source pages","graph topology"],"hosts":["C-8 analytic moves","C-3 narrative arc","IS-theory pass"]},"role_scoping":{"default_warrant_scope":"both","surface_selector":"both","argument_selector":["both","argument-only"],"intentional_root_default":"argument-only"}}},
        "c7_fence":{"const":{"anchor_scope":["domain_conventions","argument_derivation"],"protected_identity_layer":["sentence_length_signature","cadence","repetition_tolerance","point_of_view","humor","evaluative_stance","characteristic_metaphor"],"conflict_resolution":"surface_for_adjudication"}},
        "derivations":{"const":{"write":{"profile_keys":["domain_native_register.exemplar_members","domain_native_register.warrant_layers"],"discipline":"condition drafting on retrieved near-neighbor passages; retrieval does not determine generation"},"review":{"profile_keys":["domain_native_register.corpus_binding","domain_native_register.warrant_layers"],"discipline":"absence of attestation or exemplar warrant is advisory only"},"revise":{"profile_keys":["domain_native_register.warrant_layers.surface","domain_native_register.c7_fence"],"discipline":"substitute an attested construction while preserving propositional content and identity-layer boundaries"}}},
        "honesty_constraints":{"const":["corpus retrieval conditions generation but does not determine it","warrant absence is advisory only","Evaluator retains residual domain-native judgment"]},
        "expected_verification":{"type":"object","additionalProperties":false,"required":["attestation_view_pin","exemplar_view_pin","pin_epoch","pinned_at"],"properties":{"attestation_view_pin":{"$ref":"#/$defs/sha"},"exemplar_view_pin":{"$ref":"#/$defs/sha"},"pin_epoch":{"type":"integer","minimum":1},"pinned_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}}}
      }
    },
    "phase_values": {"const": ["Ph1", "Ph2", "Ph3", "Ph4"]},
    "passage_roles": {"$ref": "#/$defs/nonemptyUniqueStrings"},
    "sub_checks": {
      "type": "object", "additionalProperties": false,
      "required": ["A", "B", "C", "D", "E", "F", "G", "H"],
      "properties": {
        "A": {"$ref": "#/$defs/baseCheck"}, "B": {"$ref": "#/$defs/baseCheck"},
        "C": {"$ref": "#/$defs/baseCheck"}, "D": {"$ref": "#/$defs/baseCheck"},
        "E": {"$ref": "#/$defs/baseCheck"}, "F": {"$ref": "#/$defs/baseCheck"},
        "G": {"$ref": "#/$defs/transitionCheck"}, "H": {"const":{"name":"register_appropriateness","scope":"resolved_passages","deterministic_disposition":"candidate_probe","gate_contribution":"aggregate_after_transition","binds_at":["Ph3","Ph4"],"advisory_at":["Ph2"],"ph2_role_overrides":{"orienting_clause":"blocker_candidate"},"threshold_key":"thresholds.register","register_model_key":"domain_native_register"}}
      }
    },
    "aggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["members", "clean", "borderline", "major", "blocker"],
      "properties": {"members": {"const": ["A", "B", "C", "D", "E", "F", "G", "H"]}, "clean": {"$ref": "#/$defs/text"}, "borderline": {"$ref": "#/$defs/text"}, "major": {"$ref": "#/$defs/text"}, "blocker": {"$ref": "#/$defs/text"}}
    },
    "adjacent_advisory_checks": {
      "type": "object", "additionalProperties": false, "required": ["VE"],
      "properties": {"VE": {"type": "object", "additionalProperties": false, "required": ["name", "scope", "gate_contribution", "aggregate_member", "route", "transition_key", "follow_up_home", "threshold_key"], "properties": {"name": {"const": "verdict_edge_discipline"}, "scope": {"const": "sentence_clause"}, "gate_contribution": {"const": "none"}, "aggregate_member": {"const": false}, "route": {"$ref": "#/$defs/text"}, "transition_key": {"const": "transitions.VE"}, "follow_up_home": {"$ref": "#/$defs/text"}, "threshold_key":{"const":"thresholds.verdict_edge"}}}}
    },
    "thresholds": {
      "type": "object", "additionalProperties": false, "required": ["cadence", "rhythm", "first_use", "section_signpost", "jargon", "worked_example", "consolidation", "register", "verdict_edge"],
      "properties": {
        "cadence": {"type": "object", "additionalProperties": false, "required": ["calibration_status", "unit", "hard_ceiling_words", "bands", "turn_point_candidates", "candidate_semantics", "functional_confirmation_required", "functional_classes", "internal_sentence_break_signals", "above_ceiling", "persistence"], "properties": {
          "calibration_status": {"const": "provisional"},
          "unit": {"const": "paragraph_words"}, "hard_ceiling_words": {"type": "integer", "minimum": 1},
          "bands": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["min_words", "max_words", "required_functional_turn_points", "deficit_severity"], "properties": {"min_words": {"type": "integer", "minimum": 0}, "max_words": {"type": "integer", "minimum": 0}, "required_functional_turn_points": {"type": "integer", "minimum": 0}, "deficit_severity": {"enum": ["CLEAN", "MINOR", "MAJOR"]}}}},
          "turn_point_candidates": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "candidate_semantics": {"const": "nomination_only"}, "functional_confirmation_required": {"const": true}, "functional_classes": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "internal_sentence_break_signals": {"const": ["em_dash", "colon", "semicolon"]},
          "above_ceiling": {"type": "object", "additionalProperties": false, "required": ["current_severity_floor", "mandatory_split", "blocker_when"], "properties": {"current_severity_floor": {"const": "MAJOR"}, "mandatory_split": {"const": true}, "blocker_when": {"const": "zero functional turn-points AND zero internal sentence-break signals"}}},
          "persistence": {"type": "object", "additionalProperties": false, "required": ["identity_key", "reset_on_content_hash_change", "changes_current_severity", "planner_workflow_trigger_after_unchanged_rounds"], "properties": {"identity_key": {"const": "paragraph_content_sha256"}, "reset_on_content_hash_change": {"const": true}, "changes_current_severity": {"const": false}, "planner_workflow_trigger_after_unchanged_rounds": {"type": "integer", "minimum": 1}}}
        }},
        "rhythm": {"$ref": "#/$defs/rhythm"}, "first_use":{"$ref":"#/$defs/firstUse"}, "section_signpost":{"$ref":"#/$defs/sectionSignpost"}, "jargon": {"$ref": "#/$defs/jargon"}, "worked_example":{"$ref":"#/$defs/workedExample"}, "consolidation": {"$ref": "#/$defs/consolidation"}, "register": {"$ref": "#/$defs/register"}, "verdict_edge":{"$ref":"#/$defs/verdictEdge"}
      }
    },
    "transitions": {"type": "object", "additionalProperties": false, "required": ["G", "H", "VE"], "properties": {"G": {"$ref": "#/$defs/transition", "properties": {"state_owner": {"const": "phase_state.json.milestone_framework.policy_bindings.reader_accessibility.transitions.G"}}}, "H": {"$ref": "#/$defs/transition", "properties": {"state_owner": {"const": "phase_state.json.milestone_framework.policy_bindings.reader_accessibility.transitions.H"}}}, "VE": {"$ref": "#/$defs/transition", "properties": {"state_owner": {"const": "phase_state.json.milestone_framework.policy_bindings.reader_accessibility.transitions.VE"}}}}},
    "runtime_modes": {"type":"object","additionalProperties":false,"required":["stability"],"properties":{"stability":{"type":"object","additionalProperties":false,"required":["aggregation_source","independent_member_exclusions","negative_prefilter_short_circuit"],"properties":{"aggregation_source":{"const":"resolved_profile_and_bound_transition_state"},"independent_member_exclusions":{"const":false},"negative_prefilter_short_circuit":{"const":false}}}}},
    "register_scope": {"type": "object", "additionalProperties": false, "required": ["technical", "mixed", "non-technical"], "properties": {"technical": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "mixed": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "non-technical": {"const": ["all_passages"]}}},
    "lexicons": {"type": "object", "additionalProperties": false, "required": ["plain_connectives", "latinate_whitelist", "hedges", "nominalisation_suffixes", "prepositions"], "properties": {"plain_connectives": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "latinate_whitelist": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "hedges": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "nominalisation_suffixes": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "prepositions": {"$ref": "#/$defs/nonemptyUniqueStrings"}}},
    "domain_token_exclusions": {"$ref": "#/$defs/nonemptyUniqueStrings"},
    "override_contract": {
      "type": "object", "additionalProperties": false, "required": ["directives", "plain_connectives", "hedges", "latinate_whitelist", "terminology", "glossary"],
      "properties": {
        "directives": {"type": "object", "additionalProperties": false, "required": ["path", "passage_scope_class_key", "legacy_register_class_alias", "project_identity_key"], "properties": {"path": {"const": "research_notes/directives.md"}, "passage_scope_class_key": {"const": "passage_scope_class"}, "legacy_register_class_alias": {"const": true}, "project_identity_key": {"const": "project_id"}}},
        "plain_connectives": {"$ref": "#/$defs/replaceConnectives"}, "hedges": {"$ref": "#/$defs/replaceHedges"}, "latinate_whitelist": {"$ref": "#/$defs/supplementLatinate"}, "terminology": {"$ref": "#/$defs/extendTerminology"}, "glossary": {"$ref": "#/$defs/extendGlossary"}
      }
    },
    "remediation_order": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/text"}},
    "recurrence": {"type":"object","additionalProperties":false,"required":["project_lesson_consecutive_rounds","package_lesson_distinct_projects","state_owner","semantic_severity_effect"],"properties":{"project_lesson_consecutive_rounds":{"type":"integer","minimum":1},"package_lesson_distinct_projects":{"type":"integer","minimum":1},"state_owner":{"$ref":"#/$defs/text"},"semantic_severity_effect":{"const":"none"}}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "readerModel":{"type":"object","additionalProperties":false,"required":["audience_classes","imported_theory_registers","reading_task","register_class","source"],"properties":{"audience_classes":{"const":["IS scholar","software engineer","systems engineer","requirements engineer"]},"imported_theory_registers":{"const":["sociology","psychology","philosophy"]},"reading_task":{"const":"recover the argument's claims and their derivation on a single read, without leaving the page to look up a term"},"register_class":{"const":"domain-native"},"source":{"const":"M1 milestone reader declaration"}}},
    "warrantLayer":{"type":"object","additionalProperties":false,"required":["question","sources","hosts"],"properties":{"question":{"$ref":"#/$defs/text"},"sources":{"$ref":"#/$defs/nonemptyUniqueStrings"},"hosts":{"$ref":"#/$defs/nonemptyUniqueStrings"}}},
    "derivation":{"type":"object","additionalProperties":false,"required":["profile_keys","discipline"],"properties":{"profile_keys":{"$ref":"#/$defs/nonemptyUniqueStrings"},"discipline":{"$ref":"#/$defs/text"}}},
    "nonemptyUniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["Ph1", "Ph2", "Ph3", "Ph4"]}},
    "baseCheck": {"type": "object", "additionalProperties": false, "required": ["name", "scope", "deterministic_disposition", "gate_contribution", "binds_at", "advisory_at"], "properties": {"name": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"}, "deterministic_disposition": {"enum": ["candidate_probe", "judgment_only"]}, "gate_contribution": {"const": "aggregate"}, "binds_at": {"$ref": "#/$defs/phases"}, "advisory_at": {"$ref": "#/$defs/phases"}, "threshold_key": {"$ref": "#/$defs/text"}, "do_not_flag_guards": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "ph2_role_overrides": {"type": "object", "additionalProperties": {"enum": ["advisory", "blocker_candidate"]}}}},
    "transitionCheck": {"type": "object", "additionalProperties": false, "required": ["name", "scope", "deterministic_disposition", "gate_contribution", "binds_at", "advisory_at"], "properties": {"name": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"}, "deterministic_disposition": {"enum": ["candidate_probe", "judgment_only"]}, "gate_contribution": {"const": "aggregate_after_transition"}, "binds_at": {"$ref": "#/$defs/phases"}, "advisory_at": {"$ref": "#/$defs/phases"}, "threshold_key": {"$ref": "#/$defs/text"}, "ph2_role_overrides": {"type": "object", "additionalProperties": {"enum": ["advisory", "blocker_candidate"]}}}},
    "positive": {"type": "number", "minimum": 0},
    "rhythm": {"type": "object", "additionalProperties": false, "required": ["minimum_sentence_count", "mean_words_above", "standard_deviation_below", "short_sentence_words_at_most", "long_sentence_words_at_least"], "properties": {"minimum_sentence_count": {"$ref": "#/$defs/positive"}, "mean_words_above": {"$ref": "#/$defs/positive"}, "standard_deviation_below": {"$ref": "#/$defs/positive"}, "short_sentence_words_at_most": {"$ref": "#/$defs/positive"}, "long_sentence_words_at_least": {"$ref": "#/$defs/positive"}}},
    "firstUse":{"type":"object","additionalProperties":false,"required":["definition_window_paragraphs","manuscript_major_section_failures_min"],"properties":{"definition_window_paragraphs":{"type":"integer","minimum":0},"manuscript_major_section_failures_min":{"type":"integer","minimum":1}}},
    "sectionSignpost":{"type":"object","additionalProperties":false,"required":["opening_sentences_min","opening_sentences_max"],"properties":{"opening_sentences_min":{"type":"integer","minimum":1},"opening_sentences_max":{"type":"integer","minimum":1}}},
    "stages": {"type": "object", "additionalProperties": false, "required": ["P0", "P1", "P2"], "properties": {"P0": {"type": "integer", "minimum": 0}, "P1": {"type": "integer", "minimum": 0}, "P2": {"type": "integer", "minimum": 0}}},
    "jargon": {"type": "object", "additionalProperties": false, "required": ["new_domain_terms_per_paragraph"], "properties": {"new_domain_terms_per_paragraph": {"$ref": "#/$defs/stages"}}},
    "workedExample":{"type":"object","additionalProperties":false,"required":["rhetorical_question_stack_min","example_window_paragraphs"],"properties":{"rhetorical_question_stack_min":{"type":"integer","minimum":1},"example_window_paragraphs":{"type":"integer","minimum":0}}},
    "consolidation": {"type": "object", "additionalProperties": false, "required": ["construct_accumulation", "prior_sections_dependency", "candidate_gap_words", "candidate_gap_paragraphs", "pre_heading_scan_paragraphs", "short_manuscript_guidance_words", "long_manuscript_candidate_words", "deterministic_gap_is_proxy_only"], "properties": {"construct_accumulation": {"$ref": "#/$defs/positive"}, "prior_sections_dependency": {"$ref": "#/$defs/positive"}, "candidate_gap_words": {"$ref": "#/$defs/stages"}, "candidate_gap_paragraphs": {"$ref": "#/$defs/positive"}, "pre_heading_scan_paragraphs": {"type":"integer","minimum":1}, "short_manuscript_guidance_words": {"$ref": "#/$defs/positive"}, "long_manuscript_candidate_words": {"$ref": "#/$defs/positive"}, "deterministic_gap_is_proxy_only": {"const": true}}},
    "register": {"type": "object", "additionalProperties": false, "required": ["minimum_positive_markers", "positive_marker_count", "nominalisation_density_candidate", "prepositional_run_candidate", "hedges_per_100_words_candidate", "functional_removability_required", "severity_model"], "properties": {"minimum_positive_markers": {"$ref": "#/$defs/positive"}, "positive_marker_count": {"$ref": "#/$defs/positive"}, "nominalisation_density_candidate": {"$ref": "#/$defs/positive"}, "prepositional_run_candidate": {"$ref": "#/$defs/positive"}, "hedges_per_100_words_candidate": {"$ref": "#/$defs/positive"}, "functional_removability_required": {"const": true}, "severity_model": {"type": "object", "additionalProperties": false, "required": ["minor_negative_markers_min", "minor_negative_markers_max", "major_consecutive_passages", "weighted_roles", "ph2_orienting_zero_positive", "nontechnical_blocker_major_fraction_above"], "properties": {"minor_negative_markers_min": {"type": "integer", "minimum": 1}, "minor_negative_markers_max": {"type": "integer", "minimum": 1}, "major_consecutive_passages": {"type": "integer", "minimum": 1}, "weighted_roles": {"$ref": "#/$defs/nonemptyUniqueStrings"}, "ph2_orienting_zero_positive": {"const": "blocker_candidate"}, "nontechnical_blocker_major_fraction_above": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}}}}},
    "verdictEdge":{"type":"object","additionalProperties":false,"required":["intensifier_tokens_min","intensifier_classes_min"],"properties":{"intensifier_tokens_min":{"type":"integer","minimum":1},"intensifier_classes_min":{"type":"integer","minimum":1}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["meaning", "required_observed_count", "retirement_event", "workflow_effect_while_active", "stability_mode_effect", "state_owner"], "properties": {"meaning": {"$ref": "#/$defs/text"}, "required_observed_count": {"type": "integer", "minimum": 1}, "retirement_event": {"const": "planner_transition_approved"}, "workflow_effect_while_active": {"$ref": "#/$defs/text"}, "workflow_effect_after_retirement": {"$ref": "#/$defs/text"}, "stability_mode_effect": {"$ref":"#/$defs/text"}, "state_owner": {"$ref": "#/$defs/text"}}},
    "replaceConnectives": {"type": "object", "additionalProperties": false, "required": ["path", "polarity"], "properties": {"path": {"const": "research_notes/plain_connectives.txt"}, "polarity": {"const": "replace"}}},
    "replaceHedges": {"type": "object", "additionalProperties": false, "required": ["path", "polarity"], "properties": {"path": {"const": "research_notes/hedges.txt"}, "polarity": {"const": "replace"}}},
    "supplementLatinate": {"type": "object", "additionalProperties": false, "required": ["path", "polarity"], "properties": {"path": {"const": "research_notes/latinate_whitelist.txt"}, "polarity": {"const": "supplement"}}},
    "extendTerminology": {"type": "object", "additionalProperties": false, "required": ["path", "polarity"], "properties": {"path": {"const": "research_notes/terminology.txt"}, "polarity": {"const": "extend_domain_token_exclusions"}}},
    "extendGlossary": {"type": "object", "additionalProperties": false, "required": ["path", "polarity"], "properties": {"path": {"const": "research_notes/glossary.txt"}, "polarity": {"const": "extend_domain_token_exclusions"}}}
  }
}
