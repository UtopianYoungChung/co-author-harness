{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/assignment_milestone_checkpoint.schema.json",
  "title": "Planner milestone checkpoint input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "milestone", "feedback_records", "inputs_consumed",
    "decisions_frozen", "open_debts", "next_milestone_instructions",
    "policy_evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "milestone": {"enum": ["M1", "M2", "M3", "M4", "M5"]},
    "feedback_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feedback_record"}
    },
    "inputs_consumed": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    },
    "decisions_frozen": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_debts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "next_milestone_instructions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "policy_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_generation", "draft_evaluation"],
      "properties": {
        "draft_generation": {"$ref": "#/$defs/evidence_binding"},
        "draft_evaluation": {"$ref": "#/$defs/evidence_binding"},
        "wiki_grounding": {
          "type": "object", "additionalProperties": false,
          "required": ["evidence_path", "evidence_sha256"],
          "properties": {
            "evidence_path": {"type": "string", "minLength": 1},
            "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "wiki_grounding_opt_out": {
          "type": "object", "additionalProperties": false,
          "required": ["authority", "reason", "evidence_path", "evidence_sha256"],
          "properties": {
            "authority": {"enum": ["user", "advisor", "instructor"]},
            "reason": {"type": "string", "minLength": 1},
            "evidence_path": {"type": "string", "minLength": 1},
            "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "phase": {"enum": ["Ph1", "Ph2", "Ph3", "Ph4"]},
        "cycle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_path", "evidence_sha256"],
      "properties": {
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "feedback_record": {
      "type": "object", "additionalProperties": false,
      "required": [
        "feedback_id", "evidence_class", "source_path", "source_sha256",
        "source_actor", "source_authority", "source_milestone",
        "target_milestone", "received_at", "contemporaneity_evidence_path",
        "contemporaneity_evidence_sha256", "lineage_id", "blocking",
        "disposition", "rationale", "successor_effect"
      ],
      "properties": {
        "feedback_id": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["direct_milestone_feedback", "retrospective_application", "harness_review_evidence", "cross_cutting_guidance"]},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_actor": {"type": "string", "minLength": 1},
        "source_authority": {"enum": ["user", "venue", "advisor", "instructor", "committee", "project_local_contract"]},
        "source_milestone": {"enum": ["M1", "M2", "M3", "M4", "M5"]},
        "target_milestone": {"enum": ["M1", "M2", "M3", "M4", "M5"]},
        "received_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
        "contemporaneity_evidence_path": {"type": "string", "minLength": 1},
        "contemporaneity_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "lineage_id": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "disposition": {"enum": ["accepted", "partially_accepted", "rejected", "deferred", "informational"]},
        "rationale": {"type": "string", "minLength": 1},
        "successor_effect": {"type": "string", "minLength": 1}
      }
    }
  }
}
