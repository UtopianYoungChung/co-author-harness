{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/release_qualification_controller.schema.json",
  "title": "Release qualification controller terminal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "run_id", "request_sha256", "intent_sha256", "intent", "state", "argv", "cwd", "environment_delta", "inputs", "input_roots", "ignored_output_paths", "controller_created_output_roots", "worker", "process", "timestamps", "exit", "exit_capsule", "prechild_refusal", "child_attestation", "stdout", "stderr", "journal", "diagnostic", "recovered"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_type": {"const": "release_qualification_controller"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "intent": {"$ref": "#/$defs/binding"},
    "state": {"enum": ["succeeded", "child_failed", "cancelled", "refused", "evidence_incomplete"]},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cwd": {"type": "string", "minLength": 1},
    "environment_delta": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "input_roots": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "entry_count", "inventory_sha256", "inventory"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "entry_count": {"type": "integer", "minimum": 0},
          "inventory_sha256": {"$ref": "#/$defs/sha256"},
          "inventory": {
            "type": "object",
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["kind"],
              "properties": {
                "kind": {"enum": ["file", "directory", "reparse_file", "reparse_directory"]},
                "sha256": {"$ref": "#/$defs/sha256"},
                "byte_length": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "ignored_output_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "controller_created_output_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "worker": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["host", "pid", "process_token", "started_at"],
         "properties": {
           "host": {"type": "string"}, "pid": {"type": "integer", "minimum": 1},
           "process_token": {"type": "string", "minLength": 1}, "started_at": {"type": "string", "minLength": 1}
         }}
      ]
    },
    "process": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["pid", "process_group"],
         "properties": {"pid": {"type": "integer", "minimum": 1}, "process_group": {"type": "integer", "minimum": 1}}}
      ]
    },
    "timestamps": {
      "type": "object", "additionalProperties": false,
      "required": ["controller_started_at", "worker_started_at", "child_started_at", "child_exited_at", "finalized_at"],
      "properties": {
        "controller_started_at": {"type": "string", "minLength": 1},
        "worker_started_at": {"type": ["string", "null"]},
        "child_started_at": {"type": ["string", "null"]},
        "child_exited_at": {"type": ["string", "null"]},
        "finalized_at": {"type": "string", "minLength": 1}
      }
    },
    "exit": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["returncode"], "properties": {"returncode": {"type": "integer"}}}]},
    "exit_capsule": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
    "prechild_refusal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
    "child_attestation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
    "stdout": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
    "stderr": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]},
    "journal": {"$ref": "#/$defs/binding"},
    "diagnostic": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code"],
         "properties": {"code": {"type": "string", "minLength": 1}, "detail": {"type": "string"},
                        "paths": {"type": "array", "items": {"type": "string"}}}}
      ]
    },
    "recovered": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["succeeded", "child_failed", "cancelled"]}}, "required": ["state"]},
      "then": {"properties": {"exit": {"type": "object"}, "exit_capsule": {"type": "object"}, "stdout": {"type": "object"}, "stderr": {"type": "object"}}}
    },
    {
      "if": {"properties": {"state": {"const": "succeeded"}}, "required": ["state"]},
      "then": {"properties": {"exit": {"properties": {"returncode": {"const": 0}}}, "diagnostic": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"const": "child_failed"}}, "required": ["state"]},
      "then": {"properties": {"exit": {"properties": {"returncode": {"not": {"const": 0}}}}, "diagnostic": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"const": "refused"}}, "required": ["state"]},
      "then": {"properties": {"diagnostic": {"type": "object"}}}
    },
    {
      "if": {"properties": {"state": {"const": "evidence_incomplete"}}, "required": ["state"]},
      "then": {"properties": {"diagnostic": {"type": "object", "properties": {"code": {"const": "EVIDENCE_INCOMPLETE"}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
