{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/semantics_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "harness_identity", "members", "deferred_components"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_type": {"const": "verifier_semantics"},
    "harness_identity": {"type": "string", "minLength": 1},
    "members": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "evidence_type"], "properties": {"path": {"type": "string", "pattern": "^[^\\\\].+"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence_type": {"type": "string", "minLength": 1}}}},
    "deferred_components": {"const": ["claim_validator:C4"]}
  }
}
