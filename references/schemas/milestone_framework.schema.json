{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/milestone_framework.schema.json",
  "title": "Milestone feedback framework",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mode",
    "primary_lineage",
    "milestones"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "native",
        "legacy"
      ]
    },
    "primary_lineage": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "M1",
        "M2",
        "M3",
        "M4",
        "M5"
      ],
      "properties": {
        "M1": {
          "$ref": "#/$defs/milestone"
        },
        "M2": {
          "$ref": "#/$defs/milestone"
        },
        "M3": {
          "$ref": "#/$defs/milestone"
        },
        "M4": {
          "$ref": "#/$defs/manuscript_milestone"
        },
        "M5": {
          "$ref": "#/$defs/manuscript_milestone"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "artifact_kind",
        "path",
        "sha256",
        "bytes",
        "verified_at",
        "lineage_id"
      ],
      "properties": {
        "role": {
          "enum": [
            "deliverable",
            "transition_control",
            "evidence",
            "derived_view",
            "export"
          ]
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feedback_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_id",
        "evidence_class",
        "source_path",
        "source_sha256",
        "source_actor",
        "source_milestone",
        "target_milestone",
        "received_at",
        "lineage_id",
        "blocking",
        "disposition",
        "rationale",
        "successor_effect"
      ],
      "properties": {
        "feedback_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "direct_milestone_feedback",
            "retrospective_application",
            "harness_review_evidence",
            "cross_cutting_guidance"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_actor": {
          "type": "string",
          "minLength": 1
        },
        "source_milestone": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ]
        },
        "target_milestone": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ]
        },
        "received_at": {
          "type": "string",
          "minLength": 1
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "pending",
            "accepted",
            "partially_accepted",
            "rejected",
            "deferred",
            "informational"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "successor_effect": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authority",
        "evidence_path",
        "approved_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "reopened",
            "not_applicable"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_path": {
          "$ref": "#/$defs/nullable_path"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "packet_path",
        "packet_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_ready",
            "ready",
            "consumed",
            "needs_revalidation",
            "not_applicable"
          ]
        },
        "packet_path": {
          "$ref": "#/$defs/nullable_path"
        },
        "packet_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "authorized_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "reason",
        "scope",
        "substitute_evidence",
        "event_type"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "substitute_evidence": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "const": "authorized_override"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "status",
        "applicability",
        "required_inputs",
        "exit_criteria",
        "artifacts",
        "feedback_records",
        "approval",
        "handoff",
        "dependency_state",
        "authorized_override"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "feedback_pending",
            "revision_required",
            "accepted",
            "reopened",
            "superseded",
            "not_applicable",
            "legacy_unverified"
          ]
        },
        "applicability": {
          "enum": [
            "applicable",
            "not_applicable"
          ]
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "feedback_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/feedback_record"
          }
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "handoff": {
          "$ref": "#/$defs/handoff"
        },
        "dependency_state": {
          "enum": [
            "current",
            "needs_revalidation",
            "not_applicable"
          ]
        },
        "authorized_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/authorized_override"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "handoff"
            ],
            "properties": {
              "handoff": {
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "ready",
                      "consumed"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "approval": {
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "applicability"
            ],
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "authorized_override": {
                "$ref": "#/$defs/authorized_override"
              },
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "else": {
            "properties": {
              "authorized_override": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "manuscript_milestone": {
      "allOf": [
        {
          "$ref": "#/$defs/milestone"
        },
        {
          "properties": {
            "artifacts": {
              "contains": {
                "type": "object",
                "required": [
                  "role",
                  "artifact_kind",
                  "path",
                  "sha256",
                  "bytes",
                  "verified_at"
                ],
                "properties": {
                  "role": {
                    "const": "deliverable"
                  },
                  "artifact_kind": {
                    "const": "manuscript"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "verified_at": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "minContains": 1
            }
          }
        }
      ]
    }
  }
}
