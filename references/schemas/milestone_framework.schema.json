{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-author-harness.local/schemas/milestone_framework.schema.json",
  "title": "Milestone feedback framework",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mode",
    "primary_lineage",
    "milestones",
    "events"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "native",
        "legacy"
      ]
    },
    "migration_boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/migration_boundary"
        },
        {
          "type": "null"
        }
      ]
    },
    "primary_lineage": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "M1",
        "M2",
        "M3",
        "M4",
        "M5"
      ],
      "properties": {
        "M1": {
          "$ref": "#/$defs/milestone"
        },
        "M2": {
          "$ref": "#/$defs/milestone"
        },
        "M3": {
          "$ref": "#/$defs/milestone"
        },
        "M4": {
          "$ref": "#/$defs/manuscript_milestone"
        },
        "M5": {
          "$ref": "#/$defs/manuscript_milestone"
        }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/milestone_event" }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "legacy"
          }
        }
      },
      "then": {
        "required": [
          "migration_boundary"
        ],
        "properties": {
          "migration_boundary": {
            "$ref": "#/$defs/migration_boundary"
          }
        }
      },
      "else": {
        "properties": {
          "migration_boundary": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "milestone_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_type", "timestamp", "milestone", "lineage_id", "actor", "authority", "reason", "evidence_path", "evidence_sha256", "caused_by_sequence", "bindings"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_type": {
          "enum": ["milestone_started", "feedback_recorded", "feedback_adjudicated", "milestone_accepted", "handoff_ready", "handoff_consumed", "milestone_reopened", "downstream_stale", "downstream_revalidated", "milestone_superseded", "authorized_override", "migration_hold", "migration_accepted"]
        },
        "timestamp": { "type": "string", "minLength": 1 },
        "milestone": { "enum": ["M1", "M2", "M3", "M4", "M5"] },
        "lineage_id": { "type": "string", "minLength": 1 },
        "actor": { "enum": ["planner", "user", "advisor", "venue", "instructor", "committee", "project_local_contract"] },
        "authority": { "enum": ["user", "venue", "advisor", "instructor", "committee", "project_local_contract", null] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_path": { "$ref": "#/$defs/nullable_path" },
        "evidence_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "caused_by_sequence": { "type": ["integer", "null"], "minimum": 1 },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binding_type", "path", "sha256"],
            "properties": {
              "binding_type": { "enum": ["artifact", "feedback", "approval", "handoff_packet", "override", "migration", "previous_content", "current_content"] },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "evidence_path": { "type": "string" } } },
        "then": { "properties": { "evidence_sha256": { "$ref": "#/$defs/sha256" } } },
        "else": { "properties": { "evidence_sha256": { "type": "null" } } }
      }]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "artifact_kind",
        "path",
        "sha256",
        "bytes",
        "verified_at",
        "lineage_id"
      ],
      "properties": {
        "role": {
          "enum": [
            "deliverable",
            "transition_control",
            "evidence",
            "derived_view",
            "export"
          ]
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "supersedes_lineage_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["role"],
            "properties": {
              "role": {"const": "export"}
            }
          },
          "then": {
            "required": ["source_sha256"]
          }
        },
        {
          "if": {
            "required": ["supersedes_lineage_id"]
          },
          "then": {
            "properties": {
              "role": {"const": "deliverable"}
            }
          }
        }
      ]
    },
    "feedback_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_id",
        "evidence_class",
        "source_path",
        "source_sha256",
        "source_actor",
        "source_milestone",
        "target_milestone",
        "received_at",
        "lineage_id",
        "blocking",
        "disposition",
        "rationale",
        "successor_effect"
      ],
      "properties": {
        "feedback_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "direct_milestone_feedback",
            "retrospective_application",
            "harness_review_evidence",
            "cross_cutting_guidance"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_actor": {
          "type": "string",
          "minLength": 1
        },
        "source_milestone": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ]
        },
        "target_milestone": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ]
        },
        "received_at": {
          "type": "string",
          "minLength": 1
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "pending",
            "accepted",
            "partially_accepted",
            "rejected",
            "deferred",
            "informational"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "successor_effect": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authority",
        "evidence_path",
        "approved_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "reopened",
            "not_applicable"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_path": {
          "$ref": "#/$defs/nullable_path"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "packet_path",
        "packet_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_ready",
            "ready",
            "consumed",
            "needs_revalidation",
            "not_applicable"
          ]
        },
        "packet_path": {
          "$ref": "#/$defs/nullable_path"
        },
        "packet_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "authorized_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "authority",
        "reason",
        "scope",
        "timestamp",
        "affected_milestones",
        "affected_handoffs",
        "substitute_evidence",
        "substitute_evidence_sha256",
        "revalidation_obligations",
        "event_type"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "user",
            "venue",
            "advisor",
            "instructor",
            "committee",
            "project_local_contract"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "affected_milestones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "M1",
              "M2",
              "M3",
              "M4",
              "M5"
            ]
          }
        },
        "affected_handoffs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "substitute_evidence": {
          "type": "string",
          "minLength": 1
        },
        "substitute_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "revalidation_obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_type": {
          "const": "authorized_override"
        }
      }
    },
    "migration_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "evidence_path",
        "evidence_sha256",
        "approved_at",
        "completed_through",
        "report_path",
        "report_sha256"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "evidence_path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        },
        "completed_through": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ]
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "status",
        "applicability",
        "required_inputs",
        "exit_criteria",
        "artifacts",
        "feedback_records",
        "approval",
        "handoff",
        "dependency_state",
        "authorized_override"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "feedback_pending",
            "revision_required",
            "accepted",
            "reopened",
            "superseded",
            "not_applicable",
            "legacy_unverified"
          ]
        },
        "applicability": {
          "enum": [
            "applicable",
            "not_applicable"
          ]
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "feedback_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feedback_record"
          }
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "handoff": {
          "$ref": "#/$defs/handoff"
        },
        "dependency_state": {
          "enum": [
            "current",
            "needs_revalidation",
            "not_applicable"
          ]
        },
        "authorized_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/authorized_override"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "handoff"
            ],
            "properties": {
              "handoff": {
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "ready",
                      "consumed"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "approval": {
                "required": [
                  "status",
                  "authority",
                  "evidence_path",
                  "approved_at"
                ],
                "properties": {
                  "status": {
                    "const": "approved"
                  },
                  "authority": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "approved_at": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "handoff": {
                "properties": {
                  "packet_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "packet_sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "applicability"
            ],
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "authorized_override": {
                "$ref": "#/$defs/authorized_override"
              },
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "else": {
            "properties": {
              "authorized_override": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status",
              "applicability"
            ],
            "properties": {
              "status": {
                "const": "accepted"
              },
              "applicability": {
                "const": "applicable"
              }
            }
          },
          "then": {
            "properties": {
              "artifacts": {
                "contains": {
                  "type": "object",
                  "required": [
                    "role"
                  ],
                  "properties": {
                    "role": {
                      "const": "deliverable"
                    }
                  }
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    },
    "manuscript_milestone": {
      "allOf": [
        {
          "$ref": "#/$defs/milestone"
        },
        {
          "if": {
            "required": [
              "status",
              "applicability"
            ],
            "properties": {
              "status": {
                "const": "accepted"
              },
              "applicability": {
                "const": "applicable"
              }
            }
          },
          "then": {
            "properties": {
              "artifacts": {
                "contains": {
                  "type": "object",
                  "required": [
                    "role",
                    "artifact_kind",
                    "path",
                    "sha256",
                    "bytes",
                    "verified_at"
                  ],
                  "properties": {
                    "role": {
                      "const": "deliverable"
                    },
                    "artifact_kind": {
                      "const": "manuscript"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "verified_at": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    }
  }
}
