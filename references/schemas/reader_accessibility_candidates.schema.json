{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"reader_accessibility_candidates.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","phase","cycle_id","manuscript_path","manuscript_sha256","profile_path","profile_sha256","source_bindings","register_class","passage_scope_class","attestation_view_pin","exemplar_view_pin","candidate_only","evaluator_judgment_required","sub_checks"],
  "properties":{
    "schema_version":{"const":"reader_accessibility_candidates.v1"},
    "phase":{"enum":["Ph2","Ph3","Ph4"]},"cycle_id":{"$ref":"#/$defs/text"},
    "manuscript_path":{"$ref":"#/$defs/text"},"manuscript_sha256":{"$ref":"#/$defs/sha"},
    "profile_path":{"$ref":"#/$defs/text"},"profile_sha256":{"$ref":"#/$defs/sha"},
    "source_bindings":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},
    "register_class":{"const":"domain-native"},
    "passage_scope_class":{"enum":["technical","mixed","non-technical"]},
    "attestation_view_pin":{"$ref":"#/$defs/sha"},"exemplar_view_pin":{"$ref":"#/$defs/sha"},
    "candidate_only":{"const":true},"evaluator_judgment_required":{"const":true},
    "sub_checks":{"type":"object","additionalProperties":false,"required":["A","B","C","D","E","F","G","H"],"properties":{
      "A":{"$ref":"#/$defs/a"},"B":{"$ref":"#/$defs/judgment"},"C":{"$ref":"#/$defs/judgment"},"D":{"$ref":"#/$defs/d"},"E":{"$ref":"#/$defs/e"},"F":{"$ref":"#/$defs/f"},"G":{"$ref":"#/$defs/g"},"H":{"$ref":"#/$defs/h"}
    }}
  },
  "$defs":{
    "text":{"type":"string","minLength":1},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source":{"oneOf":[{"$ref":"#/$defs/packageSource"},{"$ref":"#/$defs/directivesSource"},{"$ref":"#/$defs/projectOverrideSource"}]},
    "packageSource":{"type":"object","additionalProperties":false,"required":["scope","path","sha256","role"],"properties":{"scope":{"const":"package"},"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha"},"role":{"enum":["package_profile","package_contributor"]}}},
    "directivesSource":{"type":"object","additionalProperties":false,"required":["scope","path","sha256","role"],"properties":{"scope":{"const":"project"},"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha"},"role":{"const":"directives"}}},
    "projectOverrideSource":{"type":"object","additionalProperties":false,"required":["scope","path","sha256","role","polarity"],"properties":{"scope":{"const":"project"},"path":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/sha"},"role":{"enum":["project_plain_connectives","project_hedges","project_latinate_whitelist","project_terminology","project_glossary"]},"polarity":{"enum":["replace","supplement","extend_domain_token_exclusions"]}}},
    "base":{"type":"object","additionalProperties":false,"required":["applicable","deterministic_disposition"],"properties":{"applicable":{"type":"boolean"},"deterministic_disposition":{"enum":["candidate_probe","judgment_only"]}}},
    "a":{"type":"object","additionalProperties":false,"required":["applicable","deterministic_disposition","candidates"],"properties":{"applicable":{"type":"boolean"},"deterministic_disposition":{"const":"candidate_probe"},"candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["paragraph","word_count","candidate_cues","candidate_status"],"properties":{"paragraph":{"type":"integer","minimum":1},"word_count":{"type":"integer","minimum":0},"candidate_cues":{"type":"array","items":{"$ref":"#/$defs/text"}},"candidate_status":{"const":"overlay_functional_confirmation_required"}}}}}},
    "judgment":{"type":"object","additionalProperties":false,"required":["applicable","deterministic_disposition","reason"],"properties":{"applicable":{"type":"boolean"},"deterministic_disposition":{"const":"judgment_only"},"reason":{"$ref":"#/$defs/text"}}},
    "d":{"type":"object","additionalProperties":false,"required":["applicable","deterministic_disposition","candidates"],"properties":{"applicable":{"type":"boolean"},"deterministic_disposition":{"const":"candidate_probe"},"candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["heading","opening_sentence_count","missing","candidate_status"],"properties":{"heading":{"$ref":"#/$defs/text"},"opening_sentence_count":{"type":"integer","minimum":0},"missing":{"type":"array","minItems":1,"items":{"enum":["orienting_clause","contribution_clause","opening_sentence_count_in_range"]}},"candidate_status":{"const":"overlay_required"}}}}}},
    "e":{"type":"object","additionalProperties":false,"required":["applicable","deterministic_disposition","candidates"],"properties":{"applicable":{"type":"boolean"},"deterministic_disposition":{"const":"candidate_probe"},"candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["paragraph","new_terms","candidate_cap","candidate_status"],"properties":{"paragraph":{"type":"integer","minimum":1},"new_terms":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"candidate_cap":{"type":"integer","minimum":1},"candidate_status":{"const":"overlay_required"}}}}}},
    "f":{"type":"object","additionalProperties":false,"required":["applicable","deterministic_disposition","candidates"],"properties":{"applicable":{"type":"boolean"},"deterministic_disposition":{"const":"candidate_probe"},"candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["paragraph","markers","candidate_status"],"properties":{"paragraph":{"type":"integer","minimum":1},"markers":{"type":"array","minItems":1,"items":{"enum":["triadic_enumerator","rhetorical_question_stack"]}},"candidate_status":{"const":"worked_example_judgment_required"}}}}}},
    "g":{"type":"object","additionalProperties":false,"required":["applicable","deterministic_disposition","proxy_label","total_words","headings","long_manuscript_proxy","candidates"],"properties":{"applicable":{"type":"boolean"},"deterministic_disposition":{"const":"candidate_probe"},"proxy_label":{"$ref":"#/$defs/text"},"total_words":{"type":"integer","minimum":0},"headings":{"type":"integer","minimum":0},"long_manuscript_proxy":{"type":"boolean"},"candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["locator","preceding_wc","para_count","gap_exceeds_words","gap_exceeds_paragraphs","pre_heading_cue_count","opening_cue_count","zero_pre_heading_cues","zero_opening_cues","g_candidate"],"properties":{"locator":{"$ref":"#/$defs/text"},"preceding_wc":{"type":"integer","minimum":0},"para_count":{"type":"integer","minimum":0},"gap_exceeds_words":{"type":"boolean"},"gap_exceeds_paragraphs":{"type":"boolean"},"pre_heading_cue_count":{"type":"integer","minimum":0},"opening_cue_count":{"type":"integer","minimum":0},"zero_pre_heading_cues":{"type":"boolean"},"zero_opening_cues":{"type":"boolean"},"g_candidate":{"const":true}}}}}},
    "probe":{"type":"object","additionalProperties":false,"required":["name","raw_count","normalised","threshold","fired"],"properties":{"name":{"enum":["nominalisation","prep_run","hedging"]},"raw_count":{"type":"integer","minimum":0},"normalised":{"type":"number","minimum":0},"threshold":{"type":"number","minimum":0},"fired":{"type":"boolean"}}},
    "h":{"type":"object","additionalProperties":false,"required":["applicable","deterministic_disposition","ph2_scope","positive_marker_audit_required","bundles"],"properties":{"applicable":{"type":"boolean"},"deterministic_disposition":{"const":"candidate_probe"},"ph2_scope":{"type":["string","null"]},"positive_marker_audit_required":{"const":true},"bundles":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["locator","passage_role","role_confidence","role_reason","binding_status","word_count","candidate_status","negative_prefilter_fired","probes"],"properties":{"locator":{"$ref":"#/$defs/text"},"passage_role":{"$ref":"#/$defs/text"},"role_confidence":{"enum":["low","medium","high"]},"role_reason":{"$ref":"#/$defs/text"},"binding_status":{"$ref":"#/$defs/text"},"word_count":{"type":"integer","minimum":0},"candidate_status":{"const":"overlay_positive_marker_audit_required"},"negative_prefilter_fired":{"type":"boolean"},"probes":{"type":"object","additionalProperties":false,"required":["nominalisation","prep_run","hedging"],"properties":{"nominalisation":{"$ref":"#/$defs/probe"},"prep_run":{"$ref":"#/$defs/probe"},"hedging":{"$ref":"#/$defs/probe"}}}}}}}}
  }
}
