{
  "schema_version": "3.0.0",
  "contract_id": "role-output-contract",
  "path_contract_version": "2.0.0",
  "authorities": {
    "academic_deliverable_writer": "generator",
    "lifecycle_state_writer": "planner",
    "handoff_writer": "planner",
    "default_acceptance_authority": "user",
    "independent_review_writer": "evaluator",
    "reflection_writer": "reflector"
  },
  "path_namespaces": {
    "deliverables": "milestones",
    "handoffs": "reviews/.harness/handoffs",
    "snapshots": "reviews/.harness/snapshots",
    "evidence": "reviews/.harness/evidence"
  },
  "output_populations": ["fixed_role", "triggered_class"],
  "invocation_scopes": ["adhoc_review", "lab_iteration", "full_lifecycle"],
  "context_kinds": ["round", "milestone", "package"],
  "suppression_reasons": [
    "TRIGGER_NOT_OBSERVED",
    "SCOPE_NOT_APPLICABLE",
    "POLICY_SUPPRESSED",
    "CARDINALITY_ALREADY_SATISFIED",
    "DEPENDENCY_UNAVAILABLE",
    "CONSUMER_AUTHORITY_PENDING"
  ],
  "path_rules": {
    "separator": "/",
    "unicode_normalization": "NFC",
    "comparison": "windows_casefold",
    "require_lexical_and_resolved_containment": true,
    "reject_absolute_drive_unc_device_traversal": true,
    "reject_links_junctions_reparse_points": true
  },
  "occurrence_identity": {
    "algorithm": "sha256",
    "canonicalization": "compact-key-sorted-utf8-json",
    "fields": [
      "contract_id",
      "contract_version",
      "contract_sha256",
      "work_id",
      "invocation_scope",
      "class_id",
      "trigger_id",
      "context",
      "ordinal",
      "triggering_evidence_sha256"
    ]
  },
  "common_generator_outputs": [
    {"role_id": "manuscript_revision_log", "path": "manuscript/revision_log.md", "mode": "append"}
  ],
  "fixed_roles": {
    "M1": {"writer": "generator", "current_path": "milestones/M1_project_memo.md", "context_kinds": ["milestone"], "operations": ["create", "modify"], "payload_schema": "markdown", "authorization_rule": "resolved_assignment_contract_and_explicit_M1_approval_for_acceptance"},
    "M2": {"writer": "generator", "current_path": "milestones/M2_annotated_references.md", "context_kinds": ["milestone"], "operations": ["create", "modify"], "payload_schema": "markdown", "authorization_rule": "resolved_assignment_contract_and_explicit_M2_approval_for_acceptance"},
    "M3": {"writer": "generator", "current_path": "milestones/M3_argument_evidence_outline.md", "context_kinds": ["milestone"], "operations": ["create", "modify"], "payload_schema": "structured-outline-markdown", "authorization_rule": "resolved_assignment_contract_and_explicit_M3_approval_for_acceptance"},
    "M4": {"writer": "generator", "current_path": "milestones/M4_complete_paper_draft.md", "context_kinds": ["milestone", "round"], "operations": ["create", "modify"], "payload_schema": "manuscript-markdown", "authorization_rule": "resolved_assignment_contract_modification_never_implies_acceptance"},
    "M5": {"writer": "generator", "current_path": "milestones/M5_final_paper.md", "context_kinds": ["milestone"], "operations": ["create", "modify"], "payload_schema": "final-manuscript-markdown", "authorization_rule": "full_lifecycle_Ph4_and_explicit_M5_approval"},
    "manuscript_revision_log": {"writer": "generator", "current_path": "manuscript/revision_log.md", "context_kinds": ["round", "milestone"], "operations": ["append"], "payload_schema": "markdown-log", "authorization_rule": "same_authority_as_recorded_manuscript_mutation"}
  },
  "triggered_output_classes": {
    "F1_evaluator_findings": {"writer": "evaluator", "trigger_id": "evaluation_blocker_or_requested", "event_type": "evaluation_exception", "context_kinds": ["round"], "invocation_scopes": ["adhoc_review", "lab_iteration", "full_lifecycle"], "path_template": "reviews/evaluator_findings_{occurrence_id}.md", "cardinality": {"minimum": 0, "maximum": null, "counting_scope": "round"}, "ordering": "occurrence_ordinal_ascending", "persistence": "immutable", "human_facing": true, "payload_schema": "references/ARTEFACT_FRONTMATTER_SCHEMA.md#family-f1", "authorization_rule": "blocker_failed_gate_explicit_request_or_verifier_requirement_consumer_controls_create_application"},
    "F2_evaluator_deterministic": {"writer": "evaluator", "trigger_id": "deterministic_report_required", "event_type": "deterministic_exception", "context_kinds": ["round"], "invocation_scopes": ["adhoc_review", "lab_iteration", "full_lifecycle"], "path_template": "reviews/evaluator_deterministic_{occurrence_id}.md", "cardinality": {"minimum": 0, "maximum": null, "counting_scope": "round"}, "ordering": "occurrence_ordinal_ascending", "persistence": "immutable", "human_facing": true, "payload_schema": "references/ARTEFACT_FRONTMATTER_SCHEMA.md#family-f2", "authorization_rule": "registered_verifier_requires_prose_otherwise_F7_consumer_controls_create_application"},
    "F3_reflector_lightweight_probe": {"writer": "reflector", "trigger_id": "reflector_probe_requested", "event_type": "reflection_probe", "context_kinds": ["round"], "invocation_scopes": ["adhoc_review", "lab_iteration", "full_lifecycle"], "path_template": "reviews/reflector_probe_{occurrence_id}.md", "cardinality": {"minimum": 0, "maximum": null, "counting_scope": "round"}, "ordering": "occurrence_ordinal_ascending", "persistence": "immutable", "human_facing": true, "payload_schema": "references/ARTEFACT_FRONTMATTER_SCHEMA.md#family-f3", "authorization_rule": "explicit_probe_dispatch_consumer_controls_create_application"},
    "F4_reflector_full_report": {"writer": "reflector", "trigger_id": "round_close_reflection", "event_type": "reflection_closeout", "context_kinds": ["round"], "invocation_scopes": ["full_lifecycle"], "path_template": "reviews/reflector_full_{round_id}.md", "cardinality": {"minimum": 0, "maximum": 1, "counting_scope": "round"}, "ordering": "after_F1_F2_F3_F7_closures", "persistence": "immutable", "human_facing": true, "payload_schema": "references/ARTEFACT_FRONTMATTER_SCHEMA.md#family-f4", "authorization_rule": "full_closeout_dispatch_consumer_controls_create_application"},
    "F5_planner_consolidated_findings": {"writer": "planner", "trigger_id": "round_findings_consolidation", "event_type": "findings_consolidation", "context_kinds": ["round"], "invocation_scopes": ["full_lifecycle"], "path_template": "reviews/consolidated_findings_{round_id}.md", "cardinality": {"minimum": 0, "maximum": 1, "counting_scope": "round"}, "ordering": "after_scheduled_finding_closures", "persistence": "immutable", "human_facing": true, "payload_schema": "references/ARTEFACT_FRONTMATTER_SCHEMA.md#family-f5", "authorization_rule": "aggregation_trigger_and_complete_scheduled_inputs_consumer_controls_create_application"},
    "F6_planner_dispatch_plan": {"writer": "planner", "trigger_id": "round_open_dispatch", "event_type": "dispatch_plan", "context_kinds": ["round"], "invocation_scopes": ["full_lifecycle"], "path_template": "reviews/dispatch_plan_{round_id}.md", "cardinality": {"minimum": 1, "maximum": 1, "counting_scope": "round_trigger"}, "ordering": "before_downstream_round_output", "persistence": "immutable", "human_facing": true, "payload_schema": "references/ARTEFACT_FRONTMATTER_SCHEMA.md#family-f6", "authorization_rule": "user_approved_dispatch_under_resolved_assignment_contract_never_lab_iteration"},
    "F7_evidence_packet": {"writer": "trigger_executor", "trigger_id": "check_evidence_recorded", "event_type": "machine_evidence", "context_kinds": ["round", "milestone", "package"], "invocation_scopes": ["adhoc_review", "lab_iteration", "full_lifecycle"], "path_template": "reviews/.harness/evidence/{event_id}.json", "cardinality": {"minimum": 0, "maximum": null, "counting_scope": "context"}, "ordering": "event_then_occurrence_ordinal_ascending", "persistence": "immutable", "human_facing": false, "payload_schema": "references/schemas/f7_evidence_packet.schema.json", "authorization_rule": "registered_check_or_governing_gate_requires_evidence_no_authority_grant"},
    "F8_final_round_report": {"writer": "planner", "trigger_id": "round_close_report", "event_type": "final_round_report", "context_kinds": ["round"], "invocation_scopes": ["full_lifecycle"], "path_template": "reviews/final_round_report_{round_id}.md", "cardinality": {"minimum": 1, "maximum": 1, "counting_scope": "round_close_trigger"}, "ordering": "after_F4_F5_F7_closures", "persistence": "immutable", "human_facing": true, "payload_schema": "references/ARTEFACT_FRONTMATTER_SCHEMA.md#family-f8+references/templates/final_round_report.md", "authorization_rule": "explicit_round_close_or_Ph4_consumer_controls_create_application"},
    "F9_milestone_handoff": {"writer": "planner", "trigger_id": "milestone_approved", "event_type": "milestone_handoff", "context_kinds": ["milestone"], "invocation_scopes": ["full_lifecycle"], "path_template": "reviews/.harness/handoffs/{milestone_id}_to_{successor_milestone_id}.json", "cardinality": {"minimum": 1, "maximum": 1, "counting_scope": "milestone_approval_trigger"}, "ordering": "milestone_order", "persistence": "immutable", "human_facing": false, "payload_schema": "references/schemas/f9_milestone_handoff.schema.json", "authorization_rule": "real_approval_provenance_and_lifecycle_gate_forbidden_in_lab_iteration"}
  },
  "classification_rules": {
    "manuscript_delta": "fixed_role:M4+fixed_role:manuscript_revision_log",
    "decision_checkpoint_machine": "triggered_class:F7_evidence_packet",
    "decision_checkpoint_human": "triggered_class:F1_evaluator_findings",
    "blocker_exception": "triggered_class:F1_evaluator_findings",
    "application_receipt": "shipment_control_member_not_output_class",
    "legacy_F1_F9": "readable_but_not_v2_transaction_evidence_by_class_alone"
  },
  "acceptance_model": "M1-M3 accept within Ph1; M4 remains mutable through Ph3 and freezes on acceptance; public FINAL maps only to ledger M5 and closes from Ph4",
  "milestones": {
    "M1": {"deliverable_writer": "generator", "deliverable_path": "milestones/M1_project_memo.md", "write_states": ["Ph1"], "acceptance_state": "Ph1", "evaluator_engagement": "bounded-independent-required", "explicit_approval_required": true, "approval_recorded_by": "planner", "handoff_path": "reviews/.harness/handoffs/M1_to_M2.json"},
    "M2": {"deliverable_writer": "generator", "deliverable_path": "milestones/M2_annotated_references.md", "write_states": ["Ph1"], "acceptance_state": "Ph1", "evaluator_engagement": "bounded-independent-required", "explicit_approval_required": true, "approval_recorded_by": "planner", "handoff_path": "reviews/.harness/handoffs/M2_to_M3.json"},
    "M3": {"deliverable_writer": "generator", "deliverable_path": "milestones/M3_argument_evidence_outline.md", "write_states": ["Ph1"], "acceptance_state": "Ph1", "content_scope": "structured-outline-only", "evaluator_engagement": "bounded-independent-required", "explicit_approval_required": true, "approval_recorded_by": "planner", "handoff_path": "reviews/.harness/handoffs/M3_to_M4.json"},
    "M4": {"deliverable_writer": "generator", "deliverable_path": "milestones/M4_complete_paper_draft.md", "write_states": ["Ph1", "Ph2", "Ph3"], "initial_assembly_state": "Ph1", "normal_review_states": ["Ph2", "Ph3"], "acceptance_readiness": "Ph3_converged", "evaluator_engagement": "bounded-independent-at-Ph1-full-from-Ph2", "feedback_adjudication_required": true, "explicit_approval_required": true, "approval_recorded_by": "planner", "handoff_path": "reviews/.harness/handoffs/M4_to_M5.json"},
    "M5": {"public_target": "FINAL", "deliverable_writer": "generator", "deliverable_path": "milestones/M5_final_paper.md", "released_export_path": "submission_bundle/final_manuscript.md", "write_states": ["Ph4"], "acceptance_state": "Ph4", "evaluator_engagement": "strict-final-required", "feedback_adjudication_required": true, "explicit_approval_required": true, "approval_recorded_by": "planner", "handoff_path": "reviews/.harness/handoffs/M5_terminal.json"}
  },
  "specialization": {
    "authority": "user-or-higher-authority-project-contract",
    "must_be_explicit": true,
    "file_presence_never_specializes": true
  }
}
