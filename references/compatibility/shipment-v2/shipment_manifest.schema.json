{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipment_manifest.schema.json",
  "title": "Typed proposal-only shipment manifest v2",
  "description": "A producer transaction proposal. No variant grants application, lifecycle, acceptance, promotion, release, or dissemination authority. Historical v1.0 and external v1.1 are readable evidence only and never satisfy this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "shipment_type", "shipment_id", "run_id", "work_id", "created_at", "producer", "contract", "effect_scope", "invocation_scope", "context", "limitations", "unresolved_findings"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "shipment_type": {"enum": ["successful_shipment", "refused_shipment"]},
    "shipment_id": {"type": "string", "pattern": "^shp-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "work_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"},
    "contract": {"$ref": "#/$defs/contract"},
    "effect_scope": {"const": "proposal_only"},
    "invocation_scope": {"enum": ["adhoc_review", "lab_iteration", "full_lifecycle"]},
    "context": {"$ref": "#/$defs/context"},
    "trigger_occurrences": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}},
    "trigger_closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
    "inventories": {"$ref": "#/$defs/inventories"},
    "proposed_operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "transaction": {"$ref": "#/$defs/transaction"},
    "refusal": {"$ref": "#/$defs/refusal"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "unresolved_findings": {"type": "array", "items": {"type": "string"}}
  },
  "oneOf": [
    {
      "properties": {"shipment_type": {"const": "successful_shipment"}},
      "required": ["trigger_occurrences", "trigger_closures", "inventories", "proposed_operations", "transaction"],
      "not": {"required": ["refusal"]}
    },
    {
      "properties": {"shipment_type": {"const": "refused_shipment"}},
      "required": ["refusal"],
      "not": {"anyOf": [{"required": ["inventories"]}, {"required": ["proposed_operations"]}, {"required": ["transaction"]}]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {"const": "co-author-harness"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_version", "kernel_sha256", "output_contract_id", "output_contract_version", "output_contract_sha256"],
      "properties": {
        "kernel_version": {"type": "string", "minLength": 1},
        "kernel_sha256": {"$ref": "#/$defs/sha256"},
        "output_contract_id": {"const": "role-output-contract"},
        "output_contract_version": {"const": "3.0.0"},
        "output_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "context": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "round_id"], "properties": {"kind": {"const": "round"}, "round_id": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "milestone_id", "milestone_event_id"], "properties": {"kind": {"const": "milestone"}, "milestone_id": {"enum": ["M1", "M2", "M3", "M4", "M5"]}, "milestone_event_id": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "package_event_id"], "properties": {"kind": {"const": "package"}, "package_event_id": {"type": "string", "minLength": 1}}}
      ]
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_id", "population", "class_id", "trigger_id", "ordinal", "triggering_evidence_sha256"],
      "properties": {
        "occurrence_id": {"$ref": "#/$defs/sha256"},
        "population": {"enum": ["fixed_role", "triggered_class"]},
        "class_id": {"type": "string", "minLength": 1},
        "trigger_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "triggering_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "payload_schema", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "payload_schema": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_id", "state"],
      "properties": {
        "occurrence_id": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["emitted", "not_applicable", "suppressed"]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "suppression_reason": {"enum": ["TRIGGER_NOT_OBSERVED", "SCOPE_NOT_APPLICABLE", "POLICY_SUPPRESSED", "CARDINALITY_ALREADY_SATISFIED", "DEPENDENCY_UNAVAILABLE", "CONSUMER_AUTHORITY_PENDING"]}
      },
      "oneOf": [
        {"properties": {"state": {"const": "emitted"}}, "required": ["artifact"], "not": {"required": ["suppression_reason"]}},
        {"properties": {"state": {"enum": ["not_applicable", "suppressed"]}}, "required": ["suppression_reason"], "not": {"required": ["artifact"]}}
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "inventories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "work", "state", "evidence", "shipment"],
      "properties": {
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "work": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "state": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "shipment": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^shipment/(MANIFEST|APPLICATION_RECEIPT|CONSUMER_OBSERVATION_RECEIPT|REFUSAL_RECEIPT|RECOVERY_RECEIPT)\\.json$"}}
      }
    },
    "preimage": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"const": "absent"}}},
        {"type": "object", "additionalProperties": false, "required": ["state", "sha256"], "properties": {"state": {"const": "present"}, "sha256": {"$ref": "#/$defs/sha256"}, "recoverable_copy": {"$ref": "#/$defs/relativePath"}}}
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "op", "destination", "artifact", "artifact_sha256", "preimage", "postimage_sha256"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "op": {"enum": ["create", "modify", "move", "rename", "delete"]},
        "destination": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "pattern": "^(work|state|evidence)/"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "preimage": {"$ref": "#/$defs/preimage"},
        "postimage_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_role": {"type": "string", "minLength": 1},
        "operation_intent": {"type": "string", "minLength": 1},
        "human_facing": {"type": "boolean"}
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal", "seal"],
      "properties": {
        "journal": {"type": "array", "items": {"enum": ["allocated", "members_written", "verified", "manifest_sealed", "closed"]}},
        "seal": {"type": "object", "additionalProperties": false, "required": ["state", "state_last"], "properties": {"state": {"enum": ["sealed", "interrupted"]}, "state_last": {"type": "boolean"}, "sha256": {"$ref": "#/$defs/sha256"}}},
        "retry": {"type": "object"},
        "exclusive_writer_count": {"type": "integer", "minimum": 0},
        "recovery": {"type": "object"},
        "rollback": {"type": "object"}
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail", "recoverable"],
      "properties": {"code": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}, "recoverable": {"type": "boolean"}}
    }
  }
}
