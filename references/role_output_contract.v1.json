{
  "schema_version": "1.0.0",
  "contract_id": "role-output-contract.v1",
  "authorities": {
    "academic_deliverable_writer": "generator",
    "lifecycle_state_writer": "planner",
    "handoff_writer": "planner",
    "default_acceptance_authority": "user",
    "independent_review_writer": "evaluator",
    "reflection_writer": "reflector"
  },
  "common_generator_outputs": [
    {"path": "manuscript/revision_log.md", "mode": "append"}
  ],
  "acceptance_model": "M1-M3 use acceptance_state because approval occurs within Ph1; M4 uses acceptance_readiness because acceptance requires convergence across Ph1-Ph3; public FINAL maps to ledger M5 and closes only from Ph4",
  "milestones": {
    "M1": {
      "deliverable_writer": "generator",
      "deliverable_path": "research_notes/project_memo.md",
      "write_states": ["Ph1"],
      "acceptance_state": "Ph1",
      "evaluator_engagement": "forbidden",
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/milestones/M1_to_M2.json"
    },
    "M2": {
      "deliverable_writer": "generator",
      "deliverable_path": "research_notes/annotated_references.md",
      "write_states": ["Ph1"],
      "acceptance_state": "Ph1",
      "evaluator_engagement": "forbidden",
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/milestones/M2_to_M3.json"
    },
    "M3": {
      "deliverable_writer": "generator",
      "deliverable_path": "manuscript/outline.md",
      "write_states": ["Ph1"],
      "acceptance_state": "Ph1",
      "content_scope": "structured-outline-only",
      "evaluator_engagement": "forbidden",
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/milestones/M3_to_M4.json"
    },
    "M4": {
      "deliverable_writer": "generator",
      "deliverable_path": "manuscript/main.md",
      "write_states": ["Ph1", "Ph2", "Ph3"],
      "initial_assembly_state": "Ph1",
      "normal_review_states": ["Ph2", "Ph3"],
      "acceptance_readiness": "Ph3_converged",
      "evaluator_engagement": "required-from-Ph2",
      "feedback_adjudication_required": true,
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/milestones/M4_to_M5.json"
    },
    "M5": {
      "public_target": "FINAL",
      "deliverable_writer": "generator",
      "deliverable_path": "manuscript/final.md",
      "released_export_path": "submission_bundle/final_manuscript.md",
      "write_states": ["Ph4"],
      "acceptance_state": "Ph4",
      "evaluator_engagement": "required",
      "feedback_adjudication_required": true,
      "explicit_approval_required": true,
      "approval_recorded_by": "planner",
      "handoff_path": "reviews/.harness/milestones/M5_terminal.json"
    }
  },
  "specialization": {
    "authority": "user-or-higher-authority-project-contract",
    "must_be_explicit": true,
    "file_presence_never_specializes": true
  }
}
